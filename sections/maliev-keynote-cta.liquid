{{ 'maliev-keynote.css' | asset_url | stylesheet_tag }}
<script src="{{ 'maliev-keynote.js' | asset_url }}" defer="defer"></script>

<section class="mkey mkey--cta" aria-label="{{ section.settings.aria_label | escape }}">
  <div class="mkey__frame" data-mkr-group>
    <h2 class="mkey__headline" data-mkr>{{ section.settings.heading }}</h2>
    {%- if section.settings.lead != blank -%}
      <p class="mkey__lead" data-mkr>{{ section.settings.lead }}</p>
    {%- endif -%}
    <div class="mkey__actions" data-mkr>
      {%- if section.settings.primary_label != blank -%}
        <a
          class="mkey__btn"
          href="{{ section.settings.primary_link | default: 'https://line.me/ti/p/@maliev' }}"
          {% if section.settings.primary_link contains '://' %}target="_blank" rel="noopener"{% endif %}
        >{{ section.settings.primary_label }}</a>
      {%- endif -%}
      {%- if section.settings.secondary_label != blank -%}
        <a
          class="mkey__btn mkey__btn--secondary"
          href="{{ section.settings.secondary_link | default: '/pages/contact' }}"
          {% if section.settings.secondary_link contains '://' %}target="_blank" rel="noopener"{% endif %}
        >{{ section.settings.secondary_label }}</a>
      {%- endif -%}
    </div>
    <div class="mkey__actions" data-mkr>
      {%- if section.settings.link_a_label != blank -%}
        <a class="mkey__textlink" href="{{ section.settings.link_a }}">
          {{ section.settings.link_a_label }}
          <span class="mkey__arrow" aria-hidden="true">&rarr;</span>
        </a>
      {%- endif -%}
      {%- if section.settings.link_b_label != blank -%}
        <a class="mkey__textlink" href="{{ section.settings.link_b }}">
          {{ section.settings.link_b_label }}
          <span class="mkey__arrow" aria-hidden="true">&rarr;</span>
        </a>
      {%- endif -%}
    </div>
    {%- if section.settings.note != blank -%}
      <p class="mkey__note" data-mkr>{{ section.settings.note }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Keynote contact hub",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "aria_label",
      "label": "Section accessibility label",
      "default": "Contact MALIEV"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Still deciding? Let's talk."
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead text",
      "default": "Comparing machines, planning a visit, or picking SimMount parts — our team replies on LINE, usually within the day."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Chat with us on LINE"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link",
      "info": "Defaults to LINE"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Request a quotation"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link",
      "info": "Defaults to /pages/contact"
    },
    {
      "type": "text",
      "id": "link_a_label",
      "label": "Text link A label",
      "default": "Compare machines"
    },
    {
      "type": "text",
      "id": "link_a",
      "label": "Text link A",
      "default": "#machines"
    },
    {
      "type": "text",
      "id": "link_b_label",
      "label": "Text link B label",
      "default": "Machine documents"
    },
    {
      "type": "text",
      "id": "link_b",
      "label": "Text link B",
      "default": "/pages/product-documents"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Trust line",
      "default": "Real engineers reply during Thailand business hours."
    }
  ],
  "presets": [{ "name": "Keynote contact hub" }]
}
{% endschema %}
