{{ 'maliev-pimm-30g.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'maliev-pimm-30g.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign next_product = section.settings.next_product
  assign next_variant = next_product.selected_or_first_available_variant
  assign selected_variant = product.selected_or_first_available_variant
  assign product_form_id = 'pimm30-product-form-' | append: section.id
  assign is_thai = false
  if request.locale.iso_code contains 'th'
    assign is_thai = true
  endif
-%}

<section
  class="pimm30-story"
  id="Pimm30Story-{{ section.id }}"
  data-pimm30-story
  data-pimm30-light-milestone="{{ section.settings.hero_light_milestone }}"
  aria-label="{{ 'products.pimm30_story.aria_label' | t | escape }}"
>
  <div class="pimm30-stage" data-pimm30-stage aria-label="{{ 'products.pimm30_story.media_stage' | t | escape }}">
    <div class="pimm30-stage__backdrop" aria-hidden="true">
      <span>Injection</span>
      <span>Molding</span>
      <span>Machine</span>
    </div>

    {%- for block in section.blocks -%}
      {%- liquid
        assign chapter_id = 'pimm30-' | append: block.settings.role
        assign media_alt_key = 'products.pimm30_story.chapters.' | append: block.settings.role | append: '.media_alt'
        assign translated_media_alt = media_alt_key | t
        if block.settings.role == 'configuration'
          assign translated_media_alt = product.title | append: ' configuration and purchase view'
        endif
        assign is_hero = false
        if block.settings.role == 'overview'
          assign is_hero = true
        endif
      -%}
      {% render 'maliev-pimm-30g-chapter',
        block: block,
        chapter_id: chapter_id,
        media_alt: translated_media_alt,
        mode: 'stage',
        eager: is_hero
      %}
    {%- endfor -%}

  </div>

  <div class="pimm30-story__chapters" data-pimm30-chapters>
    {%- for block in section.blocks -%}
      {%- liquid
        assign role = block.settings.role
        assign chapter_id = 'pimm30-' | append: role
        assign eyebrow_key = 'products.pimm30_story.chapters.' | append: role | append: '.eyebrow'
        assign heading_key = 'products.pimm30_story.chapters.' | append: role | append: '.heading'
        assign body_key = 'products.pimm30_story.chapters.' | append: role | append: '.body'
        assign metric_key = 'products.pimm30_story.chapters.' | append: role | append: '.metric'
        assign metric_label_key = 'products.pimm30_story.chapters.' | append: role | append: '.metric_label'
        assign media_alt_key = 'products.pimm30_story.chapters.' | append: role | append: '.media_alt'
        assign translated_media_alt = media_alt_key | t
        if role == 'configuration'
          assign translated_media_alt = product.title | append: ' configuration and purchase view'
        endif
      -%}
      <article
        class="pimm30-chapter pimm30-chapter--{{ role }}{% if role == 'overview' %} pimm30-chapter--hero{% endif %}"
        id="{{ chapter_id }}"
        data-pimm30-chapter="{{ chapter_id }}"
        data-chapter-role="{{ role }}"
        {% if role == 'overview' %}data-header-overlay-sentinel data-header-overlay-tone="dark"{% endif %}
        {{ block.shopify_attributes }}
      >
        <noscript>
          {% render 'maliev-pimm-30g-chapter',
            block: block,
            chapter_id: chapter_id,
            media_alt: translated_media_alt,
            mode: 'static',
            eager: forloop.first
          %}
        </noscript>

        <div class="pimm30-chapter__content">
          {%- case role -%}
            {%- when 'overview' -%}
              <h1>30 G</h1>
              <p class="pimm30-chapter__lead">{{ body_key | t }}</p>
              <dl class="pimm30-spec-rail">
                <div><dt>{{ 'products.pimm30_story.specs.capacity_label' | t }}</dt><dd>{{ 'products.pimm30_story.specs.capacity_value' | t }}</dd></div>
                <div><dt>{{ 'products.pimm30_story.specs.temperature_label' | t }}</dt><dd>{{ 'products.pimm30_story.specs.temperature_value' | t }}</dd></div>
                <div><dt>{{ 'products.pimm30_story.specs.force_label' | t }}</dt><dd>{{ 'products.pimm30_story.specs.force_value' | t }}</dd></div>
                <div><dt>{{ 'products.pimm30_story.specs.pressure_label' | t }}</dt><dd>{{ 'products.pimm30_story.specs.pressure_value' | t }}</dd></div>
              </dl>
              <a class="pimm30-action pimm30-action--primary" href="{{ section.settings.visit_link | default: '/pages/contact' }}">
                <span>{{ 'products.pimm30_story.book_visit' | t }}</span><span aria-hidden="true">→</span>
              </a>
              <a class="pimm30-scroll-cue" href="#pimm30-capacity">
                <span>{% if is_thai %}เลื่อนเพื่อดูรายละเอียด{% else %}Scroll to explore{% endif %}</span>
                <span aria-hidden="true">↓</span>
              </a>

            {%- when 'configuration' -%}
              <p class="pimm30-chapter__label">{% if is_thai %}เลือกรุ่นและอุปกรณ์{% else %}Configuration and purchase{% endif %}</p>
              <h2>{% if is_thai %}เลือกชุดเครื่องที่เหมาะกับงาน{% else %}Choose the machine setup that fits your workshop.{% endif %}</h2>
              <p>{% if is_thai %}ราคา ตัวเลือก และสถานะสินค้าด้านล่างดึงจาก Shopify โดยตรง การนัดชมเครื่องที่สำนักงานใหญ่ปากเกร็ดยังคงเป็นวิธีที่ดีที่สุดในการยืนยันแม่พิมพ์ วัสดุ และระบบลมก่อนสั่งซื้อ{% else %}Price, configuration and availability below come directly from Shopify. A demonstration at our Pak Kret headquarters is still the best way to confirm your mold, material and air-supply requirements before ordering.{% endif %}</p>
              <div class="pimm30-commerce" data-pimm30-commerce>
                <div class="pimm30-commerce__summary">
                  <strong data-pimm30-variant-title>{{ selected_variant.title | escape }}</strong>
                  <span class="pimm30-commerce__price" data-pimm30-price>{{ selected_variant.price | money_with_currency }}</span>
                  <span class="pimm30-commerce__availability{% unless selected_variant.available %} is-unavailable{% endunless %}" data-pimm30-availability>
                    {%- if selected_variant.available -%}{{ 'products.product.inventory_in_stock' | t }}{%- else -%}{{ 'products.product.inventory_out_of_stock' | t }}{%- endif -%}
                  </span>
                  {%- if product.metafields.custom.lead_time != blank -%}
                    <span>{% if is_thai %}ระยะเวลาผลิต {{ product.metafields.custom.lead_time }} วัน{% else %}{{ product.metafields.custom.lead_time }}-day production lead time{% endif %}</span>
                  {%- endif -%}
                </div>
                {%- unless product.has_only_default_variant -%}
                  <label for="Pimm30Variant-{{ section.id }}">{{ 'products.product.choose_options' | t }}</label>
                  <select id="Pimm30Variant-{{ section.id }}" data-pimm30-variant>
                    {%- for variant in product.variants -%}
                      {%- assign variant_price_text = variant.price | money_with_currency | strip_html | strip -%}
                      <option value="{{ variant.id }}" data-price="{{ variant_price_text | escape }}" data-available="{{ variant.available }}"{% if variant.id == selected_variant.id %} selected{% endif %}>{{ variant.title | escape }}</option>
                    {%- endfor -%}
                  </select>
                {%- endunless -%}
                <div class="pimm30-commerce__actions">
                  <a class="pimm30-action pimm30-action--primary" href="{{ section.settings.visit_link | default: '/pages/contact' }}"><span>{{ 'products.pimm30_story.book_visit' | t }}</span><span aria-hidden="true">→</span></a>
                  <product-form class="pimm30-product-form" data-section-id="{{ section.id }}">
                    {%- form 'product', product, id: product_form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                      <input type="hidden" name="id" value="{{ selected_variant.id }}" class="product-variant-id" data-pimm30-variant-id>
                      <button class="pimm30-action pimm30-action--secondary" type="submit" name="add" data-pimm30-add{% unless selected_variant.available %} disabled{% endunless %}>
                        <span data-pimm30-add-label>{% if selected_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span>
                        {%- render 'loading-spinner' -%}
                      </button>
                    {%- endform -%}
                    <div class="product-form__error-message-wrapper" role="alert" hidden><span class="product-form__error-message"></span></div>
                  </product-form>
                </div>
              </div>

            {%- when 'next_model' -%}
              <p class="pimm30-chapter__label">{{ eyebrow_key | t }}</p>
              <h2>{{ heading_key | t }}</h2>
              <p>{{ body_key | t }}</p>
              {%- if next_product != blank and next_variant != blank -%}
                <div class="pimm30-next-model">
                  <div><span>{{ next_product.title | escape }}</span><strong>{{ next_variant.price | money_with_currency }}</strong></div>
                  <p class="pimm30-next-model__availability{% unless next_variant.available %} is-unavailable{% endunless %}">{% if next_variant.available %}{{ 'products.product.inventory_in_stock' | t }}{% else %}{{ 'products.product.inventory_out_of_stock' | t }}{% endif %}</p>
                </div>
                <a class="pimm30-action pimm30-action--primary" href="{{ next_product.url }}"><span>{{ 'products.pimm30_story.view_50g' | t }}</span><span aria-hidden="true">→</span></a>
              {%- else -%}
                <p>{{ 'products.pimm30_story.next_model_unconfigured' | t }}</p>
              {%- endif -%}

            {%- else -%}
              <p class="pimm30-chapter__label">{{ eyebrow_key | t }}</p>
              <h2>{{ heading_key | t }}</h2>
              <p>{{ body_key | t }}</p>
              <dl class="pimm30-chapter__metric"><dt>{{ metric_label_key | t }}</dt><dd>{{ metric_key | t }}</dd></dl>
          {%- endcase -%}
        </div>
      </article>
    {%- endfor -%}
  </div>
  <script type="application/ld+json">{{ product | structured_data }}</script>
</section>

{% schema %}
{
  "name": "PIMM 30G story",
  "tag": "section",
  "class": "section section--pimm30-story",
  "settings": [
    { "type": "url", "id": "visit_link", "label": "Factory visit link" },
    { "type": "product", "id": "next_product", "label": "Next model product", "info": "Used for the final live price and availability chapter." },
    { "type": "range", "id": "hero_light_milestone", "min": 0, "max": 9750, "step": 250, "unit": "ms", "label": "Hero bright-studio milestone", "default": 2750 }
  ],
  "blocks": [
    {
      "type": "chapter",
      "name": "Machine chapter",
      "settings": [
        {
          "type": "select", "id": "role", "label": "Chapter content", "default": "overview",
          "options": [
            { "value": "overview", "label": "Overview" },
            { "value": "capacity", "label": "30g shot capacity" },
            { "value": "temperature", "label": "Temperature control" },
            { "value": "cylinder", "label": "Pneumatic cylinder" },
            { "value": "operation", "label": "Pneumatic operation" },
            { "value": "regulator", "label": "Pressure regulator" },
            { "value": "fixture", "label": "M10 fixture grid" },
            { "value": "materials", "label": "Plastic materials" },
            { "value": "configuration", "label": "Configuration and purchase" },
            { "value": "next_model", "label": "Next model" }
          ]
        },
        { "type": "header", "content": "Desktop media" },
        { "type": "video", "id": "desktop_video", "label": "Desktop video" },
        { "type": "text", "id": "desktop_video_asset", "label": "Desktop video asset filename" },
        { "type": "image_picker", "id": "desktop_poster", "label": "Desktop poster" },
        { "type": "text", "id": "desktop_poster_asset", "label": "Desktop poster asset filename" },
        { "type": "header", "content": "Mobile media" },
        { "type": "video", "id": "mobile_video", "label": "Mobile video" },
        { "type": "text", "id": "mobile_video_asset", "label": "Mobile video asset filename" },
        { "type": "image_picker", "id": "mobile_poster", "label": "Mobile poster" },
        { "type": "text", "id": "mobile_poster_asset", "label": "Mobile poster asset filename" }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [{ "name": "PIMM 30G story" }]
}
{% endschema %}
