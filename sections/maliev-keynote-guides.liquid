{{ 'maliev-keynote.css' | asset_url | stylesheet_tag }}
<script src="{{ 'maliev-keynote.js' | asset_url }}" defer="defer"></script>

<section class="mkey mkey--guides" aria-label="{{ section.settings.aria_label | escape }}">
  <div class="mkey__frame" data-mkr-group>
    <div class="mkey__guides-head" data-mkr>
      <h2 class="mkey__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.link_label != blank -%}
        <a class="mkey__textlink" href="{{ section.settings.link | default: '/blogs/news' }}">
          {{ section.settings.link_label }}
          <span class="mkey__arrow" aria-hidden="true">&rarr;</span>
        </a>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="mkey__articles" role="list">
        {%- for block in section.blocks -%}
          {%- assign guide_article = block.settings.article -%}
          <li class="mkey__article" data-mkr {{ block.shopify_attributes }}>
            <div class="mkey__article-media">
              {%- if guide_article.image -%}
                {{
                  guide_article.image
                  | image_url: width: 1000
                  | image_tag: widths: '500, 750, 1000', sizes: '(max-width: 749px) 92vw, 30vw', loading: 'lazy'
                }}
              {%- elsif block.settings.image_url != blank -%}
                <img src="{{ block.settings.image_url }}" alt="" loading="lazy" width="1000" height="667">
              {%- endif -%}
            </div>
            <h3 class="mkey__article-title">
              {%- if guide_article != blank -%}
                <a href="{{ guide_article.url }}">{{ block.settings.title | default: guide_article.title }}</a>
              {%- elsif block.settings.link != blank -%}
                <a href="{{ block.settings.link }}">{{ block.settings.title }}</a>
              {%- else -%}
                {{ block.settings.title }}
              {%- endif -%}
            </h3>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Keynote guides",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "aria_label",
      "label": "Section accessibility label",
      "default": "Guides and workshop notes"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Guides and workshop notes."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Blog link label",
      "default": "Read the blog"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Blog link"
    }
  ],
  "blocks": [
    {
      "type": "article",
      "name": "Article",
      "settings": [
        { "type": "article", "id": "article", "label": "Article" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "url", "id": "link", "label": "Link override" },
        { "type": "text", "id": "image_url", "label": "Fallback image URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Keynote guides",
      "blocks": [{ "type": "article" }, { "type": "article" }, { "type": "article" }]
    }
  ]
}
{% endschema %}
