{{ 'maliev-home-sections.css' | asset_url | stylesheet_tag }}

<section class="maliev-home">
  <div class="mh">
    <div class="mh__quote">
      <div>
        <h2>{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <p>{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>
      <div class="mh__quote-actions">
        {%- if section.settings.primary_label != blank and section.settings.primary_link != blank -%}
          <a class="mh__button" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label | escape }}</a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank and section.settings.secondary_link != blank -%}
          <a class="mh__button mh__button--secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MALIEV quote CTA",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Need help matching machines, molds, or custom parts?"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Send MALIEV your project details and we will help you choose the right machine, material, tooling path, or production support."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Request a quote"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Read guides"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "name": "MALIEV quote CTA"
    }
  ]
}
{% endschema %}
