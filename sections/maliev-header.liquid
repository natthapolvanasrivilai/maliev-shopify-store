{{ 'maliev-chrome.css' | asset_url | stylesheet_tag }}
<script src="{{ 'maliev-header.js' | asset_url }}" defer="defer"></script>
{%- if settings.cart_type == 'notification' -%}
  {{ 'component-cart-notification.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- liquid
  assign logo_alt = settings.logo.alt | default: shop.name | escape
  assign account_url = routes.account_url
  assign logo_render_width = section.settings.logo_width | times: 2
  assign header_is_home = false
  assign standalone_link_count = 0
  assign standalone_link_active = false
  assign utility_panel_block = nil
  assign localization_loading_label = 'accessibility.loading' | t
  assign localization_error_label = 'accessibility.error' | t
  if request.page_type == 'index'
    assign header_is_home = true
  endif
  if customer == blank
    assign account_url = routes.account_login_url
  endif
  for menu_link in section.settings.menu.links
    if menu_link.links == blank
      assign standalone_link_count = standalone_link_count | plus: 1
      if menu_link.current
        assign standalone_link_active = true
      endif
    endif
  endfor
  for block in section.blocks
    if block.type == 'menu_panel' and block.settings.menu_title == 'Menu'
      assign utility_panel_block = block
      break
    endif
  endfor
  assign utility_nav_label = utility_panel_block.settings.nav_label
  assign utility_eyebrow = utility_panel_block.settings.eyebrow
  assign utility_intro = utility_panel_block.settings.intro
  assign utility_cta_label = utility_panel_block.settings.cta_label
  assign utility_featured_label = utility_panel_block.settings.featured_label | default: 'Featured'
  if utility_nav_label == blank
    assign utility_nav_label = 'sections.header.menu' | t
  endif
  if request.locale.iso_code == 'th'
    assign utility_nav_label = utility_panel_block.settings.nav_label_th | default: utility_nav_label
    assign utility_eyebrow = utility_panel_block.settings.eyebrow_th | default: utility_eyebrow
    assign utility_intro = utility_panel_block.settings.intro_th | default: utility_intro
    assign utility_cta_label = utility_panel_block.settings.cta_label_th | default: utility_cta_label
    assign utility_featured_label = utility_panel_block.settings.featured_label_th | default: utility_featured_label
  endif
  assign utility_featured_link = nil
  assign utility_featured_key = utility_panel_block.settings.featured_link_title | handleize
  for menu_link in section.settings.menu.links
    if menu_link.links == blank
      assign utility_link_key = menu_link.title | handleize
      if utility_featured_link == nil or utility_link_key == utility_featured_key
        assign utility_featured_link = menu_link
      endif
      if utility_link_key == utility_featured_key
        break
      endif
    endif
  endfor
-%}

<header class="mc-header{% if section.settings.sticky %} mc-header--sticky{% endif %}{% if header_is_home %} mc-header--home{% endif %}" data-maliev-header>
  <div class="mc-header__inner">
    <details class="mc-mobile-menu">
      <summary class="mc-icon-button" aria-label="{{ 'sections.header.menu' | t }}" aria-expanded="false">
        <span class="mc-mobile-menu__open" aria-hidden="true">
          <svg viewBox="0 0 24 24" role="img"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </span>
        <span class="mc-mobile-menu__close" aria-hidden="true">
          <svg viewBox="0 0 24 24" role="img"><path d="m6 6 12 12M18 6 6 18"/></svg>
        </span>
      </summary>
      <div class="mc-mobile-menu__panel">
        <nav aria-label="{{ 'sections.header.menu' | t }}">
          <ul class="mc-mobile-nav" role="list">
            {%- for link in section.settings.menu.links -%}
              {%- if link.links != blank -%}
                <li>
                  {%- liquid
                    assign mobile_panel_block = nil
                    assign mobile_panel_key = link.title | handleize
                    for block in section.blocks
                      assign mobile_block_key = block.settings.menu_title | handleize
                      if block.type == 'menu_panel' and mobile_block_key == mobile_panel_key
                        assign mobile_panel_block = block
                        break
                      endif
                    endfor
                    assign mobile_nav_label = mobile_panel_block.settings.nav_label | default: link.title
                    assign mobile_intro = mobile_panel_block.settings.intro
                    assign mobile_cta_label = mobile_panel_block.settings.cta_label
                    if request.locale.iso_code == 'th'
                      assign mobile_nav_label = mobile_panel_block.settings.nav_label_th | default: mobile_nav_label
                      assign mobile_intro = mobile_panel_block.settings.intro_th | default: mobile_intro
                      assign mobile_cta_label = mobile_panel_block.settings.cta_label_th | default: mobile_cta_label
                    endif
                  -%}
                  <details class="mc-mobile-nav__group">
                    <summary aria-expanded="false" aria-controls="MobileMenu-{{ section.id }}-{{ forloop.index }}">
                      <span>{{ mobile_nav_label | escape }}</span>
                      <svg viewBox="0 0 12 8" aria-hidden="true"><path d="m1 1 5 5 5-5"/></svg>
                    </summary>
                    <div id="MobileMenu-{{ section.id }}-{{ forloop.index }}" class="mc-mobile-nav__content">
                      {%- if mobile_intro != blank -%}
                        <p class="mc-mobile-nav__intro">{{ mobile_intro | escape }}</p>
                      {%- endif -%}
                      {%- if mobile_cta_label != blank and mobile_panel_block.settings.cta_url != blank -%}
                        <a class="mc-mobile-nav__cta" href="{{ mobile_panel_block.settings.cta_url }}">{{ mobile_cta_label | escape }}</a>
                      {%- endif -%}
                    <ul role="list">
                      {%- if mobile_panel_key == 'our-manufacturing-services' -%}
                        {%- for block in section.blocks -%}
                          {%- if block.type == 'manufacturing_service' -%}
                            <li>{% render 'maliev-service-link', service_block: block, variant: 'mobile', show_arrow: false %}</li>
                          {%- endif -%}
                        {%- endfor -%}
                      {%- else -%}
                        {%- for childlink in link.links -%}
                          <li>
                            {% render 'maliev-menu-link', menu_link: childlink, section: section, variant: 'mobile', show_arrow: false %}
                            {%- if childlink.links != blank -%}
                              <ul role="list">
                                {%- for grandchildlink in childlink.links -%}
                                  <li>
                                    <a href="{{ grandchildlink.url }}"{% if grandchildlink.current %} aria-current="page"{% endif %}>
                                      {{ grandchildlink.title | escape }}
                                    </a>
                                  </li>
                                {%- endfor -%}
                              </ul>
                            {%- endif -%}
                          </li>
                        {%- endfor -%}
                      {%- endif -%}
                    </ul>
                    </div>
                  </details>
                </li>
              {%- endif -%}
            {%- endfor -%}
            {%- if standalone_link_count > 0 -%}
              <li>
                <details class="mc-mobile-nav__group">
                  <summary aria-expanded="false" aria-controls="MobileMenu-{{ section.id }}-more">
                    <span>{{ utility_nav_label | escape }}</span>
                    <svg viewBox="0 0 12 8" aria-hidden="true"><path d="m1 1 5 5 5-5"/></svg>
                  </summary>
                  <div id="MobileMenu-{{ section.id }}-more" class="mc-mobile-nav__content">
                    {%- if utility_intro != blank -%}
                      <p class="mc-mobile-nav__intro">{{ utility_intro | escape }}</p>
                    {%- endif -%}
                    {%- if utility_cta_label != blank and utility_panel_block.settings.cta_url != blank -%}
                      <a class="mc-mobile-nav__cta" href="{{ utility_panel_block.settings.cta_url }}">{{ utility_cta_label | escape }}</a>
                    {%- endif -%}
                    <ul role="list">
                      {%- for link in section.settings.menu.links -%}
                        {%- if link.links == blank -%}
                          <li>{% render 'maliev-menu-link', menu_link: link, section: section, variant: 'mobile', show_arrow: false %}</li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  </div>
                </details>
              </li>
            {%- endif -%}
          </ul>
        </nav>

        <div class="mc-mobile-menu__utility">
          {%- if section.settings.show_localization and localization.available_languages.size > 1 -%}
            {%- form 'localization', id: 'MalievMobileLanguage', class: 'mc-mobile-localization', data-header-localization-form: '', data-loading-label: localization_loading_label, data-error-label: localization_error_label -%}
              <label for="MalievMobileLocale">{{ 'localization.language_label' | t }}</label>
              <div class="mc-mobile-localization__control">
                <select id="MalievMobileLocale" name="language_code" data-header-localization-select data-initial-value="{{ localization.language.iso_code }}">
                  {%- for language in localization.available_languages -%}
                    <option value="{{ language.iso_code }}" lang="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>
                      {{ language.endonym_name | capitalize }}
                    </option>
                  {%- endfor -%}
                </select>
                <button class="mc-localization__submit" type="submit">{{ 'localization.update_language' | t }}</button>
              </div>
              <p class="mc-localization__status" role="status" aria-live="polite" data-header-localization-status hidden></p>
            {%- endform -%}
          {%- endif -%}
          {%- if shop.customer_accounts_enabled -%}
            <a href="{{ account_url }}">{{ 'customer.account.title' | t }}</a>
          {%- endif -%}
        </div>
      </div>
    </details>

    <a class="mc-brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {%- if settings.logo != blank -%}
        {{
          settings.logo
          | image_url: width: logo_render_width
          | image_tag:
            class: 'mc-brand__logo',
            widths: '96, 128, 160, 224, 256, 320',
            width: section.settings.logo_width,
            alt: logo_alt,
            loading: 'eager'
        }}
      {%- else -%}
        <span class="mc-brand__wordmark">{{ shop.name | escape }}</span>
      {%- endif -%}
    </a>

    <nav class="mc-nav" aria-label="{{ 'sections.header.menu' | t }}">
      <ul role="list">
        {%- for link in section.settings.menu.links -%}
          {%- if link.links != blank -%}
            {%- liquid
              assign desktop_panel_block = nil
              assign desktop_panel_key = link.title | handleize
              for block in section.blocks
                assign desktop_block_key = block.settings.menu_title | handleize
                if block.type == 'menu_panel' and desktop_block_key == desktop_panel_key
                  assign desktop_panel_block = block
                  break
                endif
              endfor
              assign desktop_nav_label = desktop_panel_block.settings.nav_label | default: link.title
              if request.locale.iso_code == 'th'
                assign desktop_nav_label = desktop_panel_block.settings.nav_label_th | default: desktop_nav_label
              endif
              assign desktop_label_id = 'MegaMenuLabel-' | append: section.id | append: '-' | append: forloop.index
            -%}
            <li>
              <details class="mc-nav__group" data-mc-mega-menu>
                <summary
                  aria-controls="MegaMenu-{{ section.id }}-{{ forloop.index }}"
                  aria-expanded="false"
                  role="button"
                  {% if link.child_active %}class="is-active"{% endif %}
                >
                  {{ desktop_nav_label | escape }}
                  <svg viewBox="0 0 12 8" aria-hidden="true"><path d="m1 1 5 5 5-5"/></svg>
                </summary>
                <div
                  id="MegaMenu-{{ section.id }}-{{ forloop.index }}"
                  class="mc-nav__panel"
                  aria-labelledby="MegaMenuLabel-{{ section.id }}-{{ forloop.index }}"
                >
                  {% render 'maliev-mega-panel', panel_title: link.title, panel_url: link.url, menu_links: link.links, section: section, label_id: desktop_label_id %}
                </div>
              </details>
            </li>
          {%- endif -%}
        {%- endfor -%}
        {%- if standalone_link_count > 0 -%}
          <li>
            <details class="mc-nav__group mc-nav__group--menu" data-mc-mega-menu>
              <summary
                aria-controls="MegaMenu-{{ section.id }}-more"
                aria-expanded="false"
                role="button"
                {% if standalone_link_active %}class="is-active"{% endif %}
              >
                {{ utility_nav_label | escape }}
                <svg viewBox="0 0 12 8" aria-hidden="true"><path d="m1 1 5 5 5-5"/></svg>
              </summary>
              <div
                id="MegaMenu-{{ section.id }}-more"
                class="mc-nav__panel mc-nav__panel--compact"
                aria-labelledby="MegaMenuLabel-{{ section.id }}-more"
              >
                <div class="mc-nav__panel-inner">
                  <div class="mc-nav__intent">
                    {%- if utility_eyebrow != blank -%}<p class="mc-nav__eyebrow">{{ utility_eyebrow | escape }}</p>{%- endif -%}
                    <h2 id="MegaMenuLabel-{{ section.id }}-more">{{ utility_nav_label | escape }}</h2>
                    {%- if utility_intro != blank -%}<p class="mc-nav__intro">{{ utility_intro | escape }}</p>{%- endif -%}
                    {%- if utility_cta_label != blank and utility_panel_block.settings.cta_url != blank -%}
                      <a class="mc-nav__cta" href="{{ utility_panel_block.settings.cta_url }}">
                        {{ utility_cta_label | escape }}
                        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 6l4 4-4 4"/></svg>
                      </a>
                    {%- endif -%}
                  </div>
                  <div class="mc-nav__link-group">
                    <p class="mc-nav__group-label">{{ 'sections.header.menu' | t }}</p>
                    <ul class="mc-nav__columns" role="list">
                    {%- for link in section.settings.menu.links -%}
                      {%- if link.links == blank -%}
                        {%- unless utility_featured_link != nil and link.url == utility_featured_link.url and link.title == utility_featured_link.title -%}
                          <li class="mc-nav__column mc-nav__column--single">
                            {% render 'maliev-menu-link', menu_link: link, section: section, variant: 'compact', show_arrow: true %}
                          </li>
                        {%- endunless -%}
                      {%- endif -%}
                    {%- endfor -%}
                    </ul>
                  </div>
                  {%- if utility_featured_link != nil -%}
                    <aside class="mc-nav__feature" aria-label="{{ utility_featured_link.title | escape }}">
                      <p class="mc-nav__group-label">{{ utility_featured_label | escape }}</p>
                      {% render 'maliev-menu-link', menu_link: utility_featured_link, section: section, variant: 'featured', show_arrow: true %}
                    </aside>
                  {%- endif -%}
                </div>
              </div>
            </details>
          </li>
        {%- endif -%}
      </ul>
    </nav>

    <div class="mc-actions">
      {%- if section.settings.show_localization and localization.available_languages.size > 1 -%}
        <details class="mc-localization">
          <summary
            class="mc-localization__summary"
            aria-label="{{ 'localization.language_label' | t }}: {{ localization.language.endonym_name | capitalize }}"
          >
            {{ localization.language.iso_code | upcase }}
            <svg viewBox="0 0 12 8" aria-hidden="true"><path d="m1 1 5 5 5-5"/></svg>
          </summary>
          <div class="mc-localization__panel">
            {%- form 'localization', id: 'MalievHeaderLanguage', class: 'mc-localization__form', data-header-localization-form: '', data-loading-label: localization_loading_label, data-error-label: localization_error_label -%}
              <label for="MalievHeaderLocale">{{ 'localization.language_label' | t }}</label>
              <select id="MalievHeaderLocale" name="language_code" data-header-localization-select data-initial-value="{{ localization.language.iso_code }}">
                {%- for language in localization.available_languages -%}
                  <option value="{{ language.iso_code }}" lang="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>
                    {{ language.endonym_name | capitalize }}
                  </option>
                {%- endfor -%}
              </select>
              <button class="mc-localization__submit" type="submit">{{ 'localization.update_language' | t }}</button>
              <p class="mc-localization__status" role="status" aria-live="polite" data-header-localization-status hidden></p>
            {%- endform -%}
          </div>
        </details>
      {%- endif -%}

      {%- if section.settings.show_search -%}
        <div class="mc-actions__search">
          {% render 'header-search', input_id: 'MalievHeaderSearch' %}
        </div>
      {%- endif -%}

      {%- if shop.customer_accounts_enabled and section.settings.show_account -%}
        <a class="mc-icon-button mc-account-link" href="{{ account_url }}" aria-label="{{ 'customer.account.title' | t }}">
          <svg viewBox="0 0 24 24" role="img" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M5 20c.5-4.1 3.1-6.2 7-6.2s6.5 2.1 7 6.2"/></svg>
        </a>
      {%- endif -%}

      <a
        id="cart-icon-bubble"
        class="mc-icon-button mc-cart-link"
        href="{{ routes.cart_url }}"
        aria-label="{{ 'templates.cart.cart' | t }}"
      >
        <svg viewBox="0 0 24 24" role="img" aria-hidden="true"><path d="M6.5 8h11l1 12h-13l1-12Z"/><path d="M9 9V6.5a3 3 0 0 1 6 0V9"/></svg>
        {%- if cart.item_count > 0 -%}
          <span class="mc-cart-count" aria-hidden="true">{{ cart.item_count }}</span>
          <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
        {%- endif -%}
      </a>
    </div>
  </div>
  <button
    class="mc-nav__backdrop"
    type="button"
    aria-label="{{ 'accessibility.close' | t }}"
    data-mc-mega-backdrop
    hidden
  ></button>
</header>

{%- if settings.cart_type == 'notification' -%}
  {%- render 'cart-notification', color_scheme: 'scheme-1', desktop_menu_type: 'dropdown' -%}
{%- endif -%}

{% schema %}
{
  "name": "MALIEV header",
  "class": "mc-header-section",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Navigation menu"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 112,
      "label": "Logo width"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "default": false,
      "label": "Keep header visible while scrolling"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "default": true,
      "label": "Show search"
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "default": true,
      "label": "Show customer account"
    },
    {
      "type": "checkbox",
      "id": "show_localization",
      "default": true,
      "label": "Show language selector"
    }
  ],
  "max_blocks": 24,
  "blocks": [
    {
      "type": "menu_detail",
      "name": "Menu link detail",
      "settings": [
        {
          "type": "text",
          "id": "link_title",
          "label": "Navigation link title",
          "info": "Must match the navigation link title exactly."
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Short description",
          "info": "Keep this to one concise sentence."
        },
        {
          "type": "textarea",
          "id": "description_th",
          "label": "Thai description",
          "info": "Shown when the storefront language is Thai."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom thumbnail"
        },
        {
          "type": "select",
          "id": "image_preset",
          "label": "MALIEV asset fallback",
          "default": "none",
          "options": [
            { "value": "none", "label": "No fallback image" },
            { "value": "machines", "label": "Injection molding machines" },
            { "value": "simmount", "label": "SimMount hardware" },
            { "value": "printed", "label": "3D printed products" },
            { "value": "molds", "label": "Molds and machined parts" },
            { "value": "mesh", "label": "Mesh Splitter" },
            { "value": "materials", "label": "Molding materials" },
            { "value": "digital", "label": "Digital files" }
          ]
        }
      ]
    },
    {
      "type": "manufacturing_service",
      "name": "Manufacturing service",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Service title"
        },
        {
          "type": "text",
          "id": "title_th",
          "label": "Thai service title"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Service page"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Short description",
          "info": "Keep this to one concise sentence."
        },
        {
          "type": "textarea",
          "id": "description_th",
          "label": "Thai description"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Featured image"
        },
        {
          "type": "select",
          "id": "image_preset",
          "label": "MALIEV asset fallback",
          "default": "none",
          "options": [
            { "value": "none", "label": "No fallback image" },
            { "value": "molds", "label": "Molds and machined parts" },
            { "value": "printed", "label": "3D printed products" },
            { "value": "materials", "label": "Molding materials" }
          ]
        }
      ]
    },
    {
      "type": "menu_panel",
      "name": "Mega-menu panel",
      "settings": [
        {
          "type": "text",
          "id": "menu_title",
          "label": "Top-level menu title",
          "info": "Must match a top-level navigation title exactly. Use Menu for standalone links."
        },
        {
          "type": "text",
          "id": "nav_label",
          "label": "Short navigation label"
        },
        {
          "type": "text",
          "id": "nav_label_th",
          "label": "Thai navigation label"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Context label"
        },
        {
          "type": "text",
          "id": "eyebrow_th",
          "label": "Thai context label"
        },
        {
          "type": "textarea",
          "id": "intro",
          "label": "Panel introduction"
        },
        {
          "type": "textarea",
          "id": "intro_th",
          "label": "Thai panel introduction"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Primary link label"
        },
        {
          "type": "text",
          "id": "cta_label_th",
          "label": "Thai primary link label"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "Primary link"
        },
        {
          "type": "text",
          "id": "featured_link_title",
          "label": "Featured navigation link",
          "info": "Must match one link inside this panel exactly."
        },
        {
          "type": "text",
          "id": "featured_label",
          "label": "Featured label",
          "default": "Featured"
        },
        {
          "type": "text",
          "id": "featured_label_th",
          "label": "Thai featured label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MALIEV header"
    }
  ]
}
{% endschema %}
