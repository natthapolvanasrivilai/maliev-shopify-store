      "id": "help_title",
      "label": "Help heading"
    },
    {
      "type": "inline_richtext",
      "id": "help_title_th",
      "label": "Thai help heading"
    },
    {
      "type": "richtext",
      "id": "help_text",
      "label": "Help text"
    },
    {
      "type": "richtext",
      "id": "help_text_th",
      "label": "Thai help text"
    },
    {
      "type": "url",
      "id": "help_link",
      "label": "Help link"
    },
    {
      "type": "text",
      "id": "help_label",
      "label": "Help link label"
    },
    {
      "type": "text",
