{{ 'maliev-home-sections.css' | asset_url | stylesheet_tag }}

<section class="maliev-home">
  <div class="mh">
    <div class="mh__section">
      <div class="mh__section-head">
        <h2 class="mh__section-title">{{ section.settings.lineup_heading | escape }}</h2>
        {%- if section.settings.lineup_text != blank -%}
          <p>{{ section.settings.lineup_text | escape }}</p>
        {%- endif -%}
      </div>
      <div class="mh__collection-grid">
        <div class="mh__collection-panel">
          <div class="mh__panel-head">
            <strong>{{ section.settings.panel_1_title | escape }}</strong>
            <span>{{ section.settings.panel_1_subtitle | escape }}</span>
          </div>
          <div class="mh__mini-products">
            {%- for block in section.blocks -%}
              {%- if block.type == 'product_card' and block.settings.group == 'panel_1' -%}
                {%- liquid
                  assign card_product = block.settings.product
                  assign card_title = block.settings.title | default: card_product.title
                  assign card_text = block.settings.text
                  assign card_link = block.settings.link
                  if card_link == blank and card_product != blank
                    assign card_link = card_product.url
                  endif
                  assign image_alt = block.settings.image_alt | default: card_title
                -%}
                <a class="mh__mini-product" href="{{ card_link }}" {{ block.shopify_attributes }}>
                  <span class="mh__mini-product-media">
                    {%- if block.settings.image != blank -%}
                      {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: image_alt, widths: '360, 540, 720, 960, 1200' }}
                    {%- elsif block.settings.asset_name != blank -%}
                      <img src="{{ block.settings.asset_name | asset_url }}" alt="{{ image_alt | escape }}" width="1200" height="1200" loading="lazy">
                    {%- elsif block.settings.image_url != blank -%}
                      <img src="{{ block.settings.image_url | escape }}" alt="{{ image_alt | escape }}" width="1200" height="1200" loading="lazy">
                    {%- elsif card_product.featured_image != blank -%}
                      {{ card_product.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: image_alt, widths: '360, 540, 720, 960, 1200' }}
                    {%- endif -%}
                  </span>
                  <strong>{{ card_title | escape }}</strong>
                  <span>{{ card_text | escape }}</span>
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
        <div class="mh__collection-panel mh__collection-panel--dark">
          <div class="mh__panel-head">
            <strong>{{ section.settings.panel_2_title | escape }}</strong>
            <span>{{ section.settings.panel_2_subtitle | escape }}</span>
          </div>
          <div class="mh__mini-products">
            {%- for block in section.blocks -%}
              {%- if block.type == 'product_card' and block.settings.group == 'panel_2' -%}
                {%- liquid
                  assign card_product = block.settings.product
                  assign card_title = block.settings.title | default: card_product.title
                  assign card_text = block.settings.text
                  assign card_link = block.settings.link
                  if card_link == blank and card_product != blank
                    assign card_link = card_product.url
                  endif
                  assign image_alt = block.settings.image_alt | default: card_title
                -%}
                <a class="mh__mini-product" href="{{ card_link }}" {{ block.shopify_attributes }}>
                  <span class="mh__mini-product-media">
                    {%- if block.settings.image != blank -%}
                      {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: image_alt, widths: '360, 540, 720, 960, 1200' }}
                    {%- elsif block.settings.asset_name != blank -%}
                      <img src="{{ block.settings.asset_name | asset_url }}" alt="{{ image_alt | escape }}" width="1200" height="1200" loading="lazy">
                    {%- elsif block.settings.image_url != blank -%}
                      <img src="{{ block.settings.image_url | escape }}" alt="{{ image_alt | escape }}" width="1200" height="1200" loading="lazy">
                    {%- elsif card_product.featured_image != blank -%}
                      {{ card_product.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: image_alt, widths: '360, 540, 720, 960, 1200' }}
                    {%- endif -%}
                  </span>
                  <strong>{{ card_title | escape }}</strong>
                  <span>{{ card_text | escape }}</span>
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>

    <div class="mh__section">
      <div class="mh__section-head">
        <h2 class="mh__section-title">{{ section.settings.featured_heading | escape }}</h2>
        {%- if section.settings.featured_text != blank -%}
          <p>{{ section.settings.featured_text | escape }}</p>
        {%- endif -%}
      </div>
      <div class="mh__product-carousel" aria-label="{{ section.settings.carousel_aria_label | escape }}">
        <div class="mh__product-track">
          {%- for block in section.blocks -%}
            {%- if block.type == 'featured_product' -%}
              {%- liquid
                assign featured_product = block.settings.product
                assign slide_title = block.settings.title | default: featured_product.title
                assign slide_link = block.settings.primary_link
                if slide_link == blank and featured_product != blank
                  assign slide_link = featured_product.url
                endif
                assign image_alt = block.settings.image_alt | default: slide_title
                assign pill_lines = block.settings.pills | newline_to_br | split: '<br />'
              -%}
              <article class="mh__product-slide" {{ block.shopify_attributes }}>
                <div class="mh__product-panel">
                  <div class="mh__panel-head">
                    <strong>{{ block.settings.panel_title | escape }}</strong>
                    <span>{{ block.settings.panel_subtitle | escape }}</span>
                  </div>
                  <div class="mh__product-layout">
                    <div class="mh__product-media">
                      {%- if block.settings.image != blank -%}
                        {{ block.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', alt: image_alt, draggable: 'false', widths: '720, 960, 1200, 1600, 1800' }}
                      {%- elsif block.settings.asset_name != blank -%}
                        <img src="{{ block.settings.asset_name | asset_url }}" alt="{{ image_alt | escape }}" width="1800" height="1800" loading="lazy" draggable="false">
                      {%- elsif block.settings.image_url != blank -%}
                        <img src="{{ block.settings.image_url | escape }}" alt="{{ image_alt | escape }}" width="1800" height="1800" loading="lazy" draggable="false">
                      {%- elsif featured_product.featured_image != blank -%}
                        {{ featured_product.featured_image | image_url: width: 1800 | image_tag: loading: 'lazy', alt: image_alt, draggable: 'false', widths: '720, 960, 1200, 1600, 1800' }}
                      {%- endif -%}
                    </div>
                    <div class="mh__product-copy">
                      {%- if block.settings.eyebrow != blank -%}
                        <p class="mh__eyebrow">{{ block.settings.eyebrow | escape }}</p>
                      {%- endif -%}
                      <h3>{{ slide_title | escape }}</h3>
                      {%- if block.settings.text != blank -%}
                        <p>{{ block.settings.text | escape }}</p>
                      {%- endif -%}
                      {%- if block.settings.price != blank or block.settings.compare_price != blank -%}
                        <div class="mh__price">
                          {%- if block.settings.compare_price != blank -%}
                            <s>{{ block.settings.compare_price | escape }}</s>
                          {%- endif -%}
                          {%- if block.settings.price != blank -%}
                            <strong>{{ block.settings.price | escape }}</strong>
                          {%- endif -%}
                        </div>
                      {%- endif -%}
                      {%- if block.settings.pills != blank -%}
                        <div class="mh__pills">
                          {%- for pill in pill_lines -%}
                            {%- assign trimmed_pill = pill | strip -%}
                            {%- if trimmed_pill != blank -%}
                              <span>{{ trimmed_pill | escape }}</span>
                            {%- endif -%}
                          {%- endfor -%}
                        </div>
                      {%- endif -%}
                      <div class="mh__price-actions">
                        {%- if block.settings.primary_label != blank and slide_link != blank -%}
                          <a class="mh__button" href="{{ slide_link }}">{{ block.settings.primary_label | escape }}</a>
                        {%- endif -%}
                        {%- if block.settings.secondary_label != blank and block.settings.secondary_link != blank -%}
                          <a class="mh__button mh__button--secondary" href="{{ block.settings.secondary_link }}">{{ block.settings.secondary_label | escape }}</a>
                        {%- endif -%}
                      </div>
                    </div>
                  </div>
                </div>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="mh__carousel-hint">
          <button class="mh__carousel-button" type="button" data-carousel-prev aria-label="{{ section.settings.prev_label | escape }}">&#8592;</button>
          {%- assign dot_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'featured_product' -%}
              <button class="mh__carousel-dot{% if dot_index == 0 %} mh__carousel-dot--active{% endif %}" type="button" data-carousel-dot="{{ dot_index }}" aria-label="{{ block.settings.dot_label | escape }}" aria-current="{% if dot_index == 0 %}true{% else %}false{% endif %}"></button>
              {%- assign dot_index = dot_index | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
          <button class="mh__carousel-button" type="button" data-carousel-next aria-label="{{ section.settings.next_label | escape }}">&#8594;</button>
          {%- if section.settings.swipe_hint != blank -%}
            <span>{{ section.settings.swipe_hint | escape }}</span>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    const root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;

    const track = root.querySelector('.mh__product-track');
    const slides = Array.from(root.querySelectorAll('.mh__product-slide'));
    const dots = Array.from(root.querySelectorAll('[data-carousel-dot]'));
    const previous = root.querySelector('[data-carousel-prev]');
    const next = root.querySelector('[data-carousel-next]');
    if (!track || slides.length < 2) return;

    const getIndex = () => Math.max(0, Math.min(slides.length - 1, Math.round(track.scrollLeft / Math.max(1, track.clientWidth))));

    const update = () => {
      const activeIndex = getIndex();
      dots.forEach((dot, index) => {
        dot.classList.toggle('mh__carousel-dot--active', index === activeIndex);
        dot.setAttribute('aria-current', index === activeIndex ? 'true' : 'false');
      });
    };

    const goTo = (index, behavior = 'smooth') => {
      const targetIndex = (index + slides.length) % slides.length;
      track.scrollTo({ left: targetIndex * track.clientWidth, behavior });
      window.requestAnimationFrame(update);
    };

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => goTo(index));
    });

    previous?.addEventListener('click', () => goTo(getIndex() - 1));
    next?.addEventListener('click', () => goTo(getIndex() + 1));
    track.addEventListener('scroll', () => window.requestAnimationFrame(update), { passive: true });
    window.addEventListener('resize', () => goTo(getIndex(), 'auto'));
    update();
  })();
</script>

{% schema %}
{
  "name": "MALIEV product showcase",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "text", "id": "lineup_heading", "label": "Lineup heading", "default": "Build a compact production workflow" },
    { "type": "textarea", "id": "lineup_text", "label": "Lineup text", "default": "Start with injection machines, then add molds, accessories, SimMount hardware, and workshop support." },
    { "type": "text", "id": "panel_1_title", "label": "Panel 1 title", "default": "Injection molding" },
    { "type": "text", "id": "panel_1_subtitle", "label": "Panel 1 subtitle", "default": "Machine lineup" },
    { "type": "text", "id": "panel_2_title", "label": "Panel 2 title", "default": "SimMount hardware" },
    { "type": "text", "id": "panel_2_subtitle", "label": "Panel 2 subtitle", "default": "Rig and tactile accessories" },
    { "type": "text", "id": "featured_heading", "label": "Featured heading", "default": "Featured machines" },
    { "type": "textarea", "id": "featured_text", "label": "Featured text", "default": "Compare the MALIEV machine sizes most customers start with." },
    { "type": "text", "id": "carousel_aria_label", "label": "Carousel accessibility label", "default": "Featured machines" },
    { "type": "text", "id": "prev_label", "label": "Previous button label", "default": "Previous featured machine" },
    { "type": "text", "id": "next_label", "label": "Next button label", "default": "Next featured machine" },
    { "type": "text", "id": "swipe_hint", "label": "Swipe hint", "default": "Swipe or use arrows to compare machines" }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Panel product card",
      "settings": [
        {
          "type": "select",
          "id": "group",
          "label": "Panel",
          "default": "panel_1",
          "options": [
            { "value": "panel_1", "label": "Panel 1" },
            { "value": "panel_2", "label": "Panel 2" }
          ]
        },
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "title", "label": "Title", "default": "Pneumatic injection machine" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Compact machine for prototypes and small batches." },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "asset_name", "label": "Theme asset image filename" },
        { "type": "text", "id": "image_url", "label": "Fallback image URL" },
        { "type": "text", "id": "image_alt", "label": "Image alt text" }
      ]
    },
    {
      "type": "featured_product",
      "name": "Featured product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "panel_title", "label": "Panel title", "default": "MALIEV machine" },
        { "type": "text", "id": "panel_subtitle", "label": "Panel subtitle", "default": "Injection molding equipment" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Featured machine" },
        { "type": "text", "id": "title", "label": "Title", "default": "MALIEV Pneumatic Injection Molding Machine" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Compact pneumatic injection molding machine for prototypes, small batches, and workshop production." },
        { "type": "text", "id": "compare_price", "label": "Compare price", "default": "฿115,000" },
        { "type": "text", "id": "price", "label": "Price", "default": "฿99,000" },
        { "type": "textarea", "id": "pills", "label": "Pills", "default": "30g capacity\nDual heaters\nLead time: 7-14 days\nAir compressor required" },
        { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "View 30g machine" },
        { "type": "url", "id": "primary_link", "label": "Primary button link" },
        { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Compare lineup" },
        { "type": "url", "id": "secondary_link", "label": "Secondary button link" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "asset_name", "label": "Theme asset image filename" },
        { "type": "text", "id": "image_url", "label": "Fallback image URL" },
        { "type": "text", "id": "image_alt", "label": "Image alt text" },
        { "type": "text", "id": "dot_label", "label": "Carousel dot label", "default": "Show featured machine" }
      ]
    }
  ],
  "presets": [
    {
      "name": "MALIEV product showcase",
      "blocks": [
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "featured_product" },
        { "type": "featured_product" }
      ]
    }
  ]
}
