{%- style -%}
  #shopify-section-{{ section.id }} {
    --maliev-home-ink: #101214;
    --maliev-home-muted: #697078;
    --maliev-home-paper: #f4f6f7;
    --maliev-home-panel: #ffffff;
    --maliev-home-line: rgba(16, 18, 20, 0.1);
    --maliev-home-blue: #006fd6;
    --maliev-home-green: #00a36c;
    --maliev-home-dark: #101418;
    background: var(--maliev-home-paper);
    color: var(--maliev-home-ink);
  }

  #shopify-section-{{ section.id }} .mh {
    background: var(--maliev-home-paper);
    font-family: var(--font-body-family);
    overflow: clip;
  }

  #shopify-section-{{ section.id }} .mh__hero {
    background: #ffffff;
    display: grid;
    grid-template-columns: 1fr;
    isolation: isolate;
    min-height: clamp(68rem, 88vh, 92rem);
    overflow: hidden;
    padding: 0 max(2rem, calc((100vw - 128rem) / 2));
    place-items: center start;
    position: relative;
  }

  #shopify-section-{{ section.id }} .mh__copy {
    align-content: center;
    display: grid;
    gap: 1.8rem;
    justify-items: start;
    max-width: 68rem;
    min-height: inherit;
    padding: clamp(6.8rem, 8vw, 9.6rem) 2rem;
    position: relative;
    text-align: left;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .mh__eyebrow {
    color: var(--maliev-home-blue);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1;
    margin: 0;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .mh__title,
  #shopify-section-{{ section.id }} .mh__section-title {
    color: var(--maliev-home-ink);
    font-family: var(--font-heading-family);
    font-weight: 600;
    letter-spacing: 0;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .mh__title {
    font-size: clamp(5.2rem, 6vw, 8.6rem);
    line-height: 0.94;
    max-width: 72rem;
    overflow-wrap: normal;
    text-wrap: balance;
    word-break: normal;
  }

  #shopify-section-{{ section.id }} .mh__title--thai {
    font-size: clamp(5.2rem, 5.8vw, 8.2rem);
    max-width: 72rem;
  }

  #shopify-section-{{ section.id }} .mh__title-line {
    display: block;
    hyphens: none;
    overflow-wrap: normal;
    white-space: nowrap;
    word-break: normal;
  }

  #shopify-section-{{ section.id }} .mh__title-line--brand {
    align-items: start;
    display: grid;
    gap: clamp(1.2rem, 1.4vw, 2.2rem);
  }

  #shopify-section-{{ section.id }} .mh__title-logo {
    display: block;
    height: 0.58em;
    max-width: 3.1em;
    object-fit: contain;
    width: auto;
  }

  #shopify-section-{{ section.id }} .mh__title-logo-text {
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .mh__lead {
    color: var(--maliev-home-muted);
    font-size: clamp(1.7rem, 1.8vw, 2.1rem);
    line-height: 1.48;
    margin: 0;
    max-width: 58rem;
  }

  #shopify-section-{{ section.id }} .mh__hero .mh__eyebrow {
    color: #7dccff;
  }

  #shopify-section-{{ section.id }} .mh__hero .mh__title {
    color: var(--maliev-home-ink);
    text-shadow: none;
  }

  #shopify-section-{{ section.id }} .mh__hero .mh__lead {
    color: #4e5963;
    max-width: 72rem;
    text-shadow: none;
  }

  #shopify-section-{{ section.id }} .mh__hero .mh__actions {
    justify-content: start;
  }

  #shopify-section-{{ section.id }} .mh__hero .mh__button--secondary {
    background: transparent;
    border-color: transparent;
    color: #4e5963;
    font-weight: 600;
    min-height: auto;
    padding: 0.8rem 0;
  }

  #shopify-section-{{ section.id }} .mh__hero .mh__button--secondary:hover,
  #shopify-section-{{ section.id }} .mh__hero .mh__button--secondary:focus-visible {
    box-shadow: none;
    color: var(--maliev-home-blue);
    transform: none;
  }

  #shopify-section-{{ section.id }} .mh__actions,
  #shopify-section-{{ section.id }} .mh__price-actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  #shopify-section-{{ section.id }} .mh__button {
    align-items: center;
    background: var(--maliev-home-blue);
    border: 1px solid var(--maliev-home-blue);
    border-radius: 999px;
    color: #ffffff;
    display: inline-flex;
    font-size: 1.35rem;
    font-weight: 600;
    justify-content: center;
    min-height: 4.7rem;
    padding: 1.2rem 1.8rem;
    text-decoration: none;
    transition: transform 160ms ease, box-shadow 160ms ease;
  }

  #shopify-section-{{ section.id }} .mh__button:hover,
  #shopify-section-{{ section.id }} .mh__button:focus-visible {
    box-shadow: 0 1rem 2.4rem rgba(0, 111, 214, 0.22);
    transform: translateY(-1px);
  }

  #shopify-section-{{ section.id }} .mh__button--secondary {
    background: #ffffff;
    border-color: rgba(16, 18, 20, 0.12);
    color: var(--maliev-home-ink);
  }

  #shopify-section-{{ section.id }} .mh__stage {
    background: #101418;
    border: 0;
    border-radius: 0;
    inset: 0;
    overflow: hidden;
    position: absolute;
    z-index: 0;
  }

  #shopify-section-{{ section.id }} .mh__stage::after {
    content: none;
  }

  #shopify-section-{{ section.id }} .mh__stage img {
    display: block;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    position: relative;
    width: 100%;
    z-index: 0;
  }

  #shopify-section-{{ section.id }} .mh__stats {
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0 auto;
    max-width: 128rem;
    padding: 0 2rem clamp(4rem, 6vw, 6rem);
  }

  #shopify-section-{{ section.id }} .mh__stat {
    background: #ffffff;
    border: 1px solid rgba(16, 18, 20, 0.08);
    display: grid;
    gap: 0.7rem;
    min-height: 12rem;
    padding: clamp(1.8rem, 3vw, 2.4rem);
  }

  #shopify-section-{{ section.id }} .mh__stat strong {
    color: var(--maliev-home-ink);
    font-size: clamp(2rem, 2.8vw, 3rem);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .mh__stat span {
    color: var(--maliev-home-muted);
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.32;
  }

  #shopify-section-{{ section.id }} .mh__tool {
    margin: 0 auto;
    max-width: 128rem;
    padding: 0 2rem clamp(4.8rem, 6vw, 7.2rem);
  }

  #shopify-section-{{ section.id }} .mh__tool-panel {
    background:
      radial-gradient(circle at 84% 18%, rgba(0, 111, 214, 0.14), transparent 32rem),
      linear-gradient(135deg, #101418 0%, #171d24 54%, #0f171d 100%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 18px;
    color: #ffffff;
    display: grid;
    gap: clamp(2.4rem, 5vw, 5.2rem);
    grid-template-columns: minmax(0, 0.98fr) minmax(38rem, 1.02fr);
    overflow: hidden;
    padding: clamp(2rem, 4vw, 4.2rem);
    position: relative;
  }

  #shopify-section-{{ section.id }} .mh__tool-copy {
    align-content: center;
    display: grid;
    gap: 1.7rem;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .mh__tool-copy .mh__eyebrow {
    color: #7dccff;
  }

  #shopify-section-{{ section.id }} .mh__tool-copy h2 {
    color: #ffffff;
    font-family: var(--font-heading-family);
    font-size: clamp(3.4rem, 4.6vw, 6rem);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 0.98;
    margin: 0;
    max-width: 12ch;
    text-wrap: balance;
  }

  #shopify-section-{{ section.id }} .mh__tool-copy p {
    color: rgba(255, 255, 255, 0.74);
    font-size: 1.55rem;
    line-height: 1.52;
    margin: 0;
    max-width: 62ch;
  }

  #shopify-section-{{ section.id }} .mh__tool-list {
    display: grid;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .mh__tool-list li {
    align-items: start;
    color: rgba(255, 255, 255, 0.82);
    display: grid;
    font-size: 1.35rem;
    gap: 0.8rem;
    grid-template-columns: auto 1fr;
    line-height: 1.35;
  }

  #shopify-section-{{ section.id }} .mh__tool-list li::before {
    background: #00a36c;
    border-radius: 999px;
    content: "";
    height: 0.8rem;
    margin-top: 0.45rem;
    width: 0.8rem;
  }

  #shopify-section-{{ section.id }} .mh__tool-pricing {
    display: grid;
    gap: 1.2rem;
    grid-column: 1 / -1;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: clamp(1.6rem, 3vw, 2.6rem);
  }

  #shopify-section-{{ section.id }} .mh__tool-price-card {
    background: linear-gradient(180deg, rgba(37, 44, 53, 0.96), rgba(17, 23, 30, 0.98));
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 12px;
    box-shadow: 0 1.8rem 4.4rem rgba(0, 0, 0, 0.22);
    color: #ffffff;
    display: flex;
    flex-direction: column;
    min-height: 31rem;
    overflow: hidden;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .mh__tool-price-card--featured {
    background:
      radial-gradient(circle at 82% 0%, rgba(95, 130, 255, 0.44), transparent 12rem),
      linear-gradient(180deg, rgba(36, 47, 78, 0.98), rgba(15, 20, 29, 0.98));
    border-color: rgba(125, 204, 255, 0.46);
    transform: translateY(-0.6rem);
  }

  #shopify-section-{{ section.id }} .mh__tool-price-top {
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    flex: none;
    flex-direction: column;
    gap: 0.85rem;
    min-height: 17rem;
    padding: 1.45rem;
  }

  #shopify-section-{{ section.id }} .mh__tool-price-row {
    align-items: center;
    display: flex;
    gap: 0.8rem;
    justify-content: space-between;
  }

  #shopify-section-{{ section.id }} .mh__tool-plan {
    color: rgba(255, 255, 255, 0.7);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.2;
    margin: 0;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .mh__tool-badge {
    background: rgba(0, 111, 214, 0.28);
    border: 1px solid rgba(125, 204, 255, 0.46);
    border-radius: 999px;
    color: #beddff;
    flex: none;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    padding: 0.28rem 0.65rem;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .mh__tool-price-card h3 {
    color: #ffffff;
    font-size: 1.55rem;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.08;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .mh__tool-amount {
    align-items: baseline;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .mh__tool-amount strong {
    color: #ffffff;
    font-size: clamp(2.8rem, 3vw, 3.8rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .mh__tool-amount small {
    color: rgba(255, 255, 255, 0.64);
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .mh__tool-summary {
    color: rgba(255, 255, 255, 0.68);
    font-size: 1.22rem;
    line-height: 1.45;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .mh__tool-plan-cta {
    align-items: center;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.06));
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 8px;
    color: #ffffff;
    display: inline-flex;
    font-size: 1.18rem;
    font-weight: 600;
    justify-content: center;
    margin-top: auto;
    min-height: 4rem;
    text-decoration: none;
    transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .mh__tool-price-card--featured .mh__tool-plan-cta {
    background: linear-gradient(180deg, #2c8dff, #006fd6);
    border-color: rgba(190, 221, 255, 0.64);
    box-shadow: 0 0 0 4px rgba(0, 111, 214, 0.18), 0 1.2rem 2.8rem rgba(0, 111, 214, 0.32);
  }

  #shopify-section-{{ section.id }} .mh__tool-price-card:hover .mh__tool-plan-cta,
  #shopify-section-{{ section.id }} .mh__tool-price-card:focus-within .mh__tool-plan-cta {
    border-color: rgba(125, 204, 255, 0.58);
    box-shadow: 0 1rem 2.4rem rgba(0, 111, 214, 0.24);
    transform: translateY(-1px);
  }

  #shopify-section-{{ section.id }} .mh__tool-features {
    flex: 1;
    padding: 1.35rem 1.45rem 1.5rem;
  }

  #shopify-section-{{ section.id }} .mh__tool-features p {
    color: rgba(255, 255, 255, 0.78);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.2;
    margin: 0 0 0.9rem;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .mh__tool-features ul {
    display: grid;
    gap: 0.78rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .mh__tool-features li {
    color: rgba(255, 255, 255, 0.72);
    font-size: 1.16rem;
    line-height: 1.4;
    padding-left: 1.8rem;
    position: relative;
  }

  #shopify-section-{{ section.id }} .mh__tool-features li::before {
    align-items: center;
    border: 1px solid rgba(255, 255, 255, 0.46);
    border-radius: 50%;
    color: #6fe5a8;
    content: "✓";
    display: flex;
    font-size: 0.8rem;
    height: 1.15rem;
    justify-content: center;
    left: 0;
    position: absolute;
    top: 0.22rem;
    width: 1.15rem;
  }

  #shopify-section-{{ section.id }} .mh__tool .mh__button--secondary {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.18);
    color: #ffffff;
  }

  #shopify-section-{{ section.id }} .mh__tool-media {
    align-self: center;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    box-shadow: 0 2.4rem 5rem rgba(0, 0, 0, 0.24);
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .mh__tool-media img,
  #shopify-section-{{ section.id }} .mh__tool-media video {
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .mh__section {
    margin: 0 auto;
    max-width: 128rem;
    padding: clamp(4.8rem, 7vw, 7.2rem) 2rem;
  }

  #shopify-section-{{ section.id }} .mh__section-head {
    align-items: end;
    display: grid;
    gap: 2rem;
    grid-template-columns: minmax(0, 1fr) minmax(28rem, 40rem);
    margin-bottom: 2.6rem;
  }

  #shopify-section-{{ section.id }} .mh__section-title {
    font-size: clamp(3.6rem, 5vw, 6.2rem);
    line-height: 0.96;
    max-width: 72rem;
    text-wrap: balance;
  }

  #shopify-section-{{ section.id }} .mh__section-head p {
    color: var(--maliev-home-muted);
    font-size: 1.55rem;
    line-height: 1.48;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .mh__line-grid {
    display: grid;
    gap: 1.6rem;
    grid-template-columns: 1.15fr 0.85fr 0.85fr;
  }

  #shopify-section-{{ section.id }} .mh__tile {
    background: #ffffff;
    border: 1px solid var(--maliev-home-line);
    border-radius: 12px;
    color: var(--maliev-home-ink);
    display: grid;
    grid-template-rows: auto 1fr;
    min-height: 28rem;
    overflow: hidden;
    position: relative;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .mh__tile--large {
    min-height: 38rem;
  }

  #shopify-section-{{ section.id }} .mh__tile--large .mh__tile-copy {
    padding-bottom: 1.4rem;
  }

  #shopify-section-{{ section.id }} .mh__tile--dark {
    background: var(--maliev-home-dark);
    color: #ffffff;
  }

  #shopify-section-{{ section.id }} .mh__tile-copy {
    display: grid;
    gap: 0.8rem;
    padding: clamp(1.8rem, 3vw, 2.6rem) clamp(1.8rem, 3vw, 2.6rem) 1rem;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .mh__tile-copy strong {
    color: inherit;
    font-size: clamp(2.4rem, 3vw, 3.2rem);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .mh__tile-copy span {
    color: rgba(16, 18, 20, 0.64);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.3;
    max-width: 28ch;
  }

  #shopify-section-{{ section.id }} .mh__tile--dark .mh__tile-copy span {
    color: rgba(255, 255, 255, 0.66);
  }

  #shopify-section-{{ section.id }} .mh__tile img {
    display: block;
    height: 100%;
    min-height: 0;
    object-fit: cover;
    object-position: center center;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .mh__tile--large img {
    object-position: right center;
  }

  #shopify-section-{{ section.id }} .mh__workflow {
    background: #ffffff;
    border-bottom: 1px solid rgba(16, 18, 20, 0.08);
    border-top: 1px solid rgba(16, 18, 20, 0.08);
  }

  #shopify-section-{{ section.id }} .mh__workflow-inner {
    display: grid;
    gap: 1.8rem;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0 auto;
    max-width: 128rem;
    padding: clamp(3.2rem, 5vw, 4.6rem) 2rem;
  }

  #shopify-section-{{ section.id }} .mh__step {
    border-left: 2px solid var(--maliev-home-line);
    display: grid;
    gap: 0.9rem;
    padding-left: 1.8rem;
  }

  #shopify-section-{{ section.id }} .mh__step b {
    color: var(--maliev-home-blue);
    font-size: 1.15rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .mh__step strong {
    color: var(--maliev-home-ink);
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .mh__step span {
    color: var(--maliev-home-muted);
    font-size: 1.3rem;
    line-height: 1.35;
  }

  #shopify-section-{{ section.id }} .mh__collection-grid {
    display: grid;
    gap: 1.6rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  #shopify-section-{{ section.id }} .mh__collection-panel,
  #shopify-section-{{ section.id }} .mh__product-panel,
  #shopify-section-{{ section.id }} .mh__article-cta {
    background: #ffffff;
    border: 1px solid var(--maliev-home-line);
    border-radius: 12px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .mh__collection-panel--dark {
    background: var(--maliev-home-dark);
    color: #ffffff;
  }

  #shopify-section-{{ section.id }} .mh__panel-head {
    align-items: center;
    border-bottom: 1px solid rgba(16, 18, 20, 0.08);
    display: flex;
    justify-content: space-between;
    min-height: 5.4rem;
    padding: 0 1.8rem;
  }

  #shopify-section-{{ section.id }} .mh__collection-panel--dark .mh__panel-head {
    border-bottom-color: rgba(255, 255, 255, 0.12);
  }

  #shopify-section-{{ section.id }} .mh__panel-head strong {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .mh__panel-head span {
    color: var(--maliev-home-muted);
    font-size: 1.2rem;
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .mh__collection-panel--dark .mh__panel-head span {
    color: rgba(255, 255, 255, 0.64);
  }

  #shopify-section-{{ section.id }} .mh__mini-products {
    display: grid;
    gap: 1.2rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding: 1.8rem;
  }

  #shopify-section-{{ section.id }} .mh__mini-product {
    background: #ffffff;
    border: 1px solid rgba(16, 18, 20, 0.08);
    border-radius: 10px;
    color: var(--maliev-home-ink);
    display: grid;
    gap: 0;
    grid-template-rows: clamp(14rem, 13vw, 17.6rem) auto auto;
    overflow: hidden;
    padding-bottom: 1.4rem;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .mh__mini-product-media {
    background: transparent;
    display: block;
    height: 100%;
    margin: 0;
    overflow: hidden;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .mh__mini-product img {
    display: block;
    height: calc(100% + 2px);
    margin: -1px;
    object-fit: cover;
    object-position: center center;
    padding: 0;
    transform: scale(1.08);
    transform-origin: center center;
    width: calc(100% + 2px);
  }

  #shopify-section-{{ section.id }} .mh__collection-panel:not(.mh__collection-panel--dark) .mh__mini-product:nth-child(-n + 2) img {
    object-position: center 54%;
  }

  #shopify-section-{{ section.id }} .mh__mini-product > strong,
  #shopify-section-{{ section.id }} .mh__mini-product > span:not(.mh__mini-product-media) {
    margin: 0 1.2rem;
  }

  #shopify-section-{{ section.id }} .mh__mini-product strong {
    color: inherit;
    font-size: 1.45rem;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.12;
    margin-top: 1.2rem;
  }

  #shopify-section-{{ section.id }} .mh__mini-product > span:not(.mh__mini-product-media) {
    color: var(--maliev-home-muted);
    font-size: 1.15rem;
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .mh__product-layout {
    display: grid;
    gap: 0;
    grid-template-columns: minmax(28rem, 0.95fr) minmax(0, 1.05fr);
  }

  #shopify-section-{{ section.id }} .mh__product-carousel {
    display: grid;
    gap: 1rem;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .mh__product-track {
    cursor: grab;
    display: flex;
    gap: 0;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scroll-padding: 0;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    touch-action: pan-y;
    user-select: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
  }

  #shopify-section-{{ section.id }} .mh__product-track.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
  }

  #shopify-section-{{ section.id }} .mh__product-track img {
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .mh__product-track::-webkit-scrollbar {
    display: none;
    height: 0;
    width: 0;
  }

  #shopify-section-{{ section.id }} .mh__product-slide {
    flex: 0 0 100%;
    min-width: 0;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  #shopify-section-{{ section.id }} .mh__product-slide .mh__product-panel {
    height: 100%;
  }

  #shopify-section-{{ section.id }} .mh__carousel-hint {
    align-items: center;
    color: var(--maliev-home-muted);
    display: flex;
    font-size: 1.25rem;
    font-weight: 600;
    gap: 0.8rem;
    justify-content: flex-end;
  }

  #shopify-section-{{ section.id }} .mh__carousel-button {
    align-items: center;
    background: #ffffff;
    border: 1px solid rgba(16, 18, 20, 0.14);
    border-radius: 999px;
    color: var(--maliev-home-ink);
    cursor: pointer;
    display: inline-flex;
    font: inherit;
    font-size: 1.5rem;
    font-weight: 600;
    height: 3.6rem;
    justify-content: center;
    line-height: 1;
    padding: 0;
    transition: background 160ms ease, border-color 160ms ease, color 160ms ease;
    width: 3.6rem;
  }

  #shopify-section-{{ section.id }} .mh__carousel-button:hover,
  #shopify-section-{{ section.id }} .mh__carousel-button:focus-visible {
    background: var(--maliev-home-blue);
    border-color: var(--maliev-home-blue);
    color: #ffffff;
  }

  #shopify-section-{{ section.id }} .mh__carousel-dot {
    background: rgba(16, 18, 20, 0.22);
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    display: inline-block;
    height: 0.7rem;
    padding: 0;
    width: 2rem;
  }

  #shopify-section-{{ section.id }} .mh__carousel-dot--active {
    background: var(--maliev-home-blue);
    width: 3.6rem;
  }

  #shopify-section-{{ section.id }} .mh__product-media {
    background: #ffffff;
    min-height: clamp(48rem, 44vw, 62rem);
    overflow: hidden;
    position: relative;
  }

  #shopify-section-{{ section.id }} .mh__product-media::after {
    background: linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, #ffffff 100%);
    content: "";
    inset: 0 0 0 auto;
    pointer-events: none;
    position: absolute;
    width: clamp(7rem, 12vw, 18rem);
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .mh__product-media img {
    display: block;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    padding: 0;
    transform: scale(1.015);
    width: 100%;
  }

  #shopify-section-{{ section.id }} .mh__product-copy {
    align-content: center;
    display: grid;
    gap: 1.4rem;
    padding: clamp(2.8rem, 5vw, 5.2rem);
  }

  #shopify-section-{{ section.id }} .mh__product-copy h3 {
    color: var(--maliev-home-ink);
    font-size: clamp(3.2rem, 4vw, 4.8rem);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 0.96;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .mh__product-copy p {
    color: var(--maliev-home-muted);
    font-size: 1.5rem;
    line-height: 1.48;
    margin: 0;
    max-width: 62rem;
  }

  #shopify-section-{{ section.id }} .mh__price {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  #shopify-section-{{ section.id }} .mh__price s {
    color: #8a9198;
    font-size: clamp(1.8rem, 2vw, 2.4rem);
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .mh__price strong {
    color: var(--maliev-home-blue);
    font-size: clamp(3rem, 4vw, 4.2rem);
    font-weight: 600;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .mh__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  #shopify-section-{{ section.id }} .mh__pills span {
    background: #eef3f8;
    border: 1px solid rgba(0, 111, 214, 0.16);
    border-radius: 999px;
    color: #245578;
    font-size: 1.2rem;
    font-weight: 600;
    padding: 0.8rem 1rem;
  }

  #shopify-section-{{ section.id }} .mh__blog-grid {
    display: grid;
    gap: 1.6rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  #shopify-section-{{ section.id }} .mh__blog-card {
    background: #ffffff;
    border: 1px solid var(--maliev-home-line);
    border-radius: 12px;
    color: var(--maliev-home-ink);
    display: grid;
    grid-template-rows: 21rem minmax(17rem, auto);
    min-height: 38rem;
    overflow: hidden;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .mh__blog-card img {
    display: block;
    height: 21rem;
    object-fit: cover;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .mh__blog-body {
    display: grid;
    gap: 0.8rem;
    padding: clamp(1.6rem, 3vw, 2.2rem);
  }

  #shopify-section-{{ section.id }} .mh__blog-body b {
    color: var(--maliev-home-blue);
    font-size: 1.1rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .mh__blog-body strong {
    color: inherit;
    font-size: clamp(1.95rem, 2vw, 2.4rem);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.08;
  }

  #shopify-section-{{ section.id }} .mh__blog-body span {
    color: var(--maliev-home-muted);
    font-size: 1.35rem;
    line-height: 1.38;
  }

  #shopify-section-{{ section.id }} .mh__article-cta {
    background: #ffffff;
    display: grid;
    gap: clamp(2rem, 4vw, 3.4rem);
    grid-template-columns: minmax(28rem, 0.85fr) minmax(0, 1.15fr);
    margin-top: 1.6rem;
    padding: clamp(2rem, 4vw, 3.2rem);
  }

  #shopify-section-{{ section.id }} .mh__article-cta img {
    aspect-ratio: 16 / 10;
    border-radius: 12px;
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .mh__article-copy {
    align-content: center;
    display: grid;
    gap: 1.5rem;
  }

  #shopify-section-{{ section.id }} .mh__article-copy h3 {
    color: var(--maliev-home-ink);
    font-size: clamp(3rem, 4vw, 5rem);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 0.98;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .mh__article-copy p {
    color: var(--maliev-home-muted);
    font-size: 1.55rem;
    line-height: 1.52;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .mh__quote {
    background:
      linear-gradient(135deg, rgba(0, 111, 214, 0.12), rgba(0, 163, 108, 0.08)),
      #ffffff;
    border: 1px solid var(--maliev-home-line);
    border-radius: 14px;
    display: grid;
    gap: 2rem;
    grid-template-columns: minmax(0, 1fr) auto;
    margin: 0 auto clamp(5rem, 7vw, 8rem);
    max-width: 128rem;
    padding: clamp(2.6rem, 5vw, 4.6rem);
  }

  #shopify-section-{{ section.id }} .mh__quote h2 {
    color: var(--maliev-home-ink);
    font-size: clamp(3.2rem, 4.5vw, 5.4rem);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 0.98;
    margin: 0 0 1rem;
  }

  #shopify-section-{{ section.id }} .mh__quote p {
    color: var(--maliev-home-muted);
    font-size: 1.55rem;
    line-height: 1.45;
    margin: 0;
    max-width: 68rem;
  }

  #shopify-section-{{ section.id }} .mh__quote-actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: end;
  }

  @media screen and (max-width: 990px) {
    #shopify-section-{{ section.id }} .mh__hero,
    #shopify-section-{{ section.id }} .mh__section-head,
    #shopify-section-{{ section.id }} .mh__line-grid,
    #shopify-section-{{ section.id }} .mh__tool-panel,
    #shopify-section-{{ section.id }} .mh__workflow-inner,
    #shopify-section-{{ section.id }} .mh__collection-grid,
    #shopify-section-{{ section.id }} .mh__product-layout,
    #shopify-section-{{ section.id }} .mh__blog-grid,
    #shopify-section-{{ section.id }} .mh__article-cta,
    #shopify-section-{{ section.id }} .mh__quote {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .mh__hero {
      min-height: clamp(58rem, 78vh, 74rem);
      padding-left: 0;
      padding-right: 0;
    }

    #shopify-section-{{ section.id }} .mh__copy {
      padding: clamp(5.6rem, 10vw, 7.2rem) 2rem;
    }

    #shopify-section-{{ section.id }} .mh__stage img {
      object-position: 58% center;
    }

    #shopify-section-{{ section.id }} .mh__stats,
    #shopify-section-{{ section.id }} .mh__mini-products {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #shopify-section-{{ section.id }} .mh__tool-price-card--featured {
      transform: none;
    }

    #shopify-section-{{ section.id }} .mh__tool-pricing {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #shopify-section-{{ section.id }} .mh__quote-actions {
      justify-content: start;
    }

    #shopify-section-{{ section.id }} .mh__blog-card {
      grid-template-rows: 22rem auto;
      min-height: auto;
    }

    #shopify-section-{{ section.id }} .mh__blog-card img {
      height: 22rem;
    }
  }

  @media screen and (max-width: 640px) {
    #shopify-section-{{ section.id }} .mh__stats,
    #shopify-section-{{ section.id }} .mh__tool-pricing,
    #shopify-section-{{ section.id }} .mh__mini-products {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .mh__title {
      font-size: clamp(3.8rem, 11vw, 5.2rem);
    }

    #shopify-section-{{ section.id }} .mh__title--thai {
      font-size: clamp(3.6rem, 11vw, 5.4rem);
    }

    #shopify-section-{{ section.id }} .mh__hero {
      min-height: 62rem;
    }

    #shopify-section-{{ section.id }} .mh__copy {
      padding: 4.8rem 1.6rem;
    }

    #shopify-section-{{ section.id }} .mh__tile,
    #shopify-section-{{ section.id }} .mh__tile--large {
      min-height: 31rem;
    }

    #shopify-section-{{ section.id }} .mh__tool {
      padding-left: 1.2rem;
      padding-right: 1.2rem;
    }

    #shopify-section-{{ section.id }} .mh__tool-panel {
      border-radius: 14px;
      padding: 1.6rem;
    }

    #shopify-section-{{ section.id }} .mh__tool-price-card {
      min-height: auto;
    }
  }
{%- endstyle -%}

{%- liquid
  assign maliev_is_thai = false
  if localization.language.iso_code == 'th' or request.locale.iso_code contains 'th' or request.path contains '/th'
    assign maliev_is_thai = true
  endif
-%}

<section class="mh" aria-label="{{ 'maliev_home_i18n.aria.storefront' | t }}">
  <div class="mh__hero">
    <div class="mh__copy">
      <p class="mh__eyebrow">
        {%- if maliev_is_thai -%}
          เครื่องมือการผลิตจาก MALIEV
        {%- else -%}
          {{ 'maliev_home_i18n.hero.eyebrow_cover' | t }}
        {%- endif -%}
      </p>
      <h1 class="mh__title{% if maliev_is_thai %} mh__title--thai{% endif %}">
        {%- if maliev_is_thai -%}
          <span class="mh__title-line">ยกระดับเวิร์กช็อป</span>
          <span class="mh__title-line">ให้พร้อมผลิตจริง</span>
        {%- else -%}
          <span class="mh__title-line">Machines,</span>
          <span class="mh__title-line">molds, and</span>
          <span class="mh__title-line">manufacturing</span>
          <span class="mh__title-line mh__title-line--brand">
            <span>support from</span>
            {%- if settings.logo != blank -%}
              {%- assign maliev_home_logo_alt = settings.logo.alt | default: shop.name | escape -%}
              {{ settings.logo | image_url: width: 560 | image_tag: class: 'mh__title-logo', loading: 'eager', alt: maliev_home_logo_alt }}
            {%- else -%}
              <span class="mh__title-logo-text">MALIEV</span>
            {%- endif -%}
          </span>
        {%- endif -%}
      </h1>
      <p class="mh__lead">
        {%- if maliev_is_thai -%}
          รวมเครื่องฉีดพลาสติก แม่พิมพ์ อุปกรณ์ SimMount และบริการผลิตชิ้นงานสำหรับงานต้นแบบ งานทดสอบ และการผลิตจำนวนน้อย
        {%- else -%}
          {{ 'maliev_home_i18n.hero.lead_cover' | t }}
        {%- endif -%}
      </p>
      <div class="mh__actions">
        <a class="mh__button" href="{{ routes.collections_url }}/%E0%B9%80%E0%B8%84%E0%B8%A3%E0%B8%B7%E0%B9%88%E0%B8%AD%E0%B8%87%E0%B8%89%E0%B8%B5%E0%B8%94%E0%B8%9E%E0%B8%A5%E0%B8%B2%E0%B8%AA%E0%B8%95%E0%B8%B4%E0%B8%81">
          {%- if maliev_is_thai -%}
            ดูไลน์อัปเครื่องฉีดพลาสติก
          {%- else -%}
            {{ 'maliev_home_i18n.hero.shop_machine_lineup_cover' | t }}
          {%- endif -%}
        </a>
        <a class="mh__button mh__button--secondary" href="http://line.me/ti/p/@maliev" target="_blank" rel="noopener">{{ 'maliev_home_i18n.hero.request_quote' | t }}</a>
      </div>
    </div>
    <div class="mh__stage" aria-hidden="true">
      <img
        src="https://cdn.shopify.com/s/files/1/0856/7426/2807/files/machine-hero-desktop-right.28.png"
        alt=""
        width="3000"
        height="1286"
        loading="eager"
      >
    </div>
  </div>

  <div class="mh__stats" aria-label="{{ 'maliev_home_i18n.aria.product_lines' | t }}">
    <div class="mh__stat"><strong>{{ 'maliev_home_i18n.stats.machines_title' | t }}</strong><span>{{ 'maliev_home_i18n.stats.machines_text' | t }}</span></div>
    <div class="mh__stat"><strong>{{ 'maliev_home_i18n.stats.molds_title' | t }}</strong><span>{{ 'maliev_home_i18n.stats.molds_text' | t }}</span></div>
    <div class="mh__stat"><strong>{{ 'maliev_home_i18n.stats.sim_title' | t }}</strong><span>{{ 'maliev_home_i18n.stats.sim_text' | t }}</span></div>
    <div class="mh__stat"><strong>{{ 'maliev_home_i18n.stats.services_title' | t }}</strong><span>{{ 'maliev_home_i18n.stats.services_text' | t }}</span></div>
  </div>

  <div class="mh__tool" aria-label="{% if maliev_is_thai %}เครื่องมือ Mesh Splitter จาก MALIEV{% else %}MALIEV Mesh Splitter tool{% endif %}">
    <div class="mh__tool-panel">
      <div class="mh__tool-copy">
        <p class="mh__eyebrow">{% if maliev_is_thai %}เครื่องมือออนไลน์{% else %}Browser tool{% endif %}</p>
        <h2>{% if maliev_is_thai %}Mesh Splitter สำหรับ STL ขนาดใหญ่{% else %}Mesh Splitter for oversized STL files{% endif %}</h2>
        <p>
          {%- if maliev_is_thai -%}
            เตรียมโมเดลขนาดใหญ่ให้พิมพ์ได้กับเครื่อง 3D printer ขนาดเล็กในเบราว์เซอร์ อัปโหลด STL, ปรับสเกล, กำหนดขนาดพื้นที่พิมพ์, แยกชิ้นงาน, เพิ่มตัวล็อก, ตรวจดูใน 3D และส่งออกเป็น ZIP พร้อมไฟล์ STL ที่ติดป้ายและคู่มือประกอบ PDF
          {%- else -%}
            Prepare large models for smaller 3D printers directly in the browser. Upload an STL, scale it, set your printer build volume, split into labeled parts, add connectors, review in 3D, and export one ZIP with labeled STLs plus a PDF assembly guide.
          {%- endif -%}
        </p>
        <ul class="mh__tool-list">
          <li>{% if maliev_is_thai %}ทำงานบนเครื่องของผู้ใช้ ไม่ต้องส่งโมเดลไปประมวลผลบนเซิร์ฟเวอร์{% else %}Runs on the customer's device, with no server-side model processing{% endif %}</li>
          <li>{% if maliev_is_thai %}เหมาะสำหรับ maker, วิศวกร, ร้านพิมพ์ 3D และทีมที่ต้องแยกโมเดลให้พอดีกับพื้นที่พิมพ์{% else %}Made for makers, engineers, 3D print shops, and teams fitting large models onto smaller printers{% endif %}</li>
          <li>{% if maliev_is_thai %}ลองใช้ฟรี 3 exports ต่อเดือน แล้วจ่ายเฉพาะเมื่อต้องการส่งออกเพิ่ม{% else %}Try 3 free exports every month, then pay only when more exports are needed{% endif %}</li>
        </ul>
        <div class="mh__actions">
          <a class="mh__button" href="/tools/mesh-splitter">{% if maliev_is_thai %}เปิด Mesh Splitter{% else %}Open Mesh Splitter{% endif %}</a>
          <a class="mh__button mh__button--secondary" href="/tools/mesh-splitter#pricing">{% if maliev_is_thai %}ดูรายละเอียดราคา{% else %}View pricing details{% endif %}</a>
        </div>
      </div>
      <div class="mh__tool-media" aria-hidden="true">
        <video
          src="https://cdn.shopify.com/videos/c/o/v/98eb9a0da3d54a8cae7010bcf57fdb9e.mp4"
          width="1536"
          height="1536"
          autoplay
          loop
          muted
          playsinline
          preload="metadata"
        ></video>
      </div>
        <div class="mh__tool-pricing" aria-label="{% if maliev_is_thai %}ราคา Mesh Splitter{% else %}Mesh Splitter pricing{% endif %}">
          <article class="mh__tool-price-card">
            <div class="mh__tool-price-top">
              <div class="mh__tool-price-row">
                <p class="mh__tool-plan">{% if maliev_is_thai %}แผนใช้ฟรี{% else %}Free monthly plan{% endif %}</p>
              </div>
              <h3>{% if maliev_is_thai %}3 exports ต่อเดือน{% else %}3 exports monthly{% endif %}</h3>
              <p class="mh__tool-amount"><strong>{% if maliev_is_thai %}ฟรี{% else %}Free{% endif %}</strong><small>{% if maliev_is_thai %}ทุกเดือน{% else %}per month{% endif %}</small></p>
              <p class="mh__tool-summary">{% if maliev_is_thai %}เริ่มทดลองกับโมเดลจริงได้โดยไม่ต้องซื้อเครดิตก่อน{% else %}Start testing real models before buying any credits.{% endif %}</p>
              <a class="mh__tool-plan-cta" href="/customer_authentication/login?return_to=%2Ftools%2Fmesh-splitter%2Fapp">{% if maliev_is_thai %}เริ่มใช้ฟรี{% else %}Start free{% endif %}</a>
            </div>
            <div class="mh__tool-features">
              <p>{% if maliev_is_thai %}รวมในแผน{% else %}Includes{% endif %}</p>
              <ul>
