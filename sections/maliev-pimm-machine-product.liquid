{%- liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign page_model = section.settings.page_model
  if page_model == '30G' or page_model == '50G'
    assign selected_variant = product.variants | where: 'option1', page_model | first
  endif
  assign selected_model_code = selected_variant.option1 | strip
  assign selected_model_block = nil
  assign model_block_match_count = 0
  assign product_model_contract_valid = false

  if product.options.size == 1 and product.options.first == 'Model' and product.variants.size == 2
    assign first_model_variant = product.variants.first
    assign second_model_variant = product.variants.last
    if first_model_variant.option1 == '30G' and second_model_variant.option1 == '50G'
      assign product_model_contract_valid = true
    endif
  endif

  for block in section.blocks
    if block.type == 'model' and block.settings.model_code == selected_model_code
      assign model_block_match_count = model_block_match_count | plus: 1
      if selected_model_block == nil
        assign selected_model_block = block
      endif
    endif
  endfor

  assign expected_story_asset_set = ''
  case selected_model_code
    when '30G'
      assign expected_story_asset_set = 'pimm-master-20260901-r05-30g'
    when '50G'
      assign expected_story_asset_set = 'pimm-master-20260901-r05-50g'
  endcase

  assign specifications = selected_variant.metafields.custom.pimm_specifications.value
  assign full_price = selected_variant.metafields.custom.full_machine_price.value
  assign selected_full_price_cents = full_price
  assign lead_time = selected_variant.metafields.custom.lead_time_days.value
  assign model_contract_valid = false
  assign selected_story_binding_valid = false

  if selected_model_block.settings.story_asset_set == blank or selected_model_block.settings.story_asset_set == expected_story_asset_set
    assign selected_story_binding_valid = true
  endif

  if product_model_contract_valid and selected_model_block != blank and model_block_match_count == 1
    if selected_story_binding_valid and specifications != blank
      if specifications.schema_version == 1 and specifications.model == selected_model_code
        if specifications.shot_capacity_g > 0 and specifications.max_melt_temperature_c > 0
          if specifications.max_air_pressure_mpa > 0 and specifications.mold_envelope_mm.width > 0
            if specifications.mold_envelope_mm.height > 0 and specifications.mold_envelope_mm.depth > 0
              if full_price != blank and lead_time > 0
                assign model_contract_valid = true
              endif
            endif
          endif
        endif
      endif
    endif
  endif

  assign factory_visit_url = section.settings.factory_visit_url
  if factory_visit_url == blank
    assign factory_visit_url = pages['contact'].url
  endif
  if factory_visit_url == blank
    assign factory_visit_url = routes.root_url | append: '/pages/contact' | replace: '//', '/'
  endif
-%}

<link rel="stylesheet" href="{{ 'maliev-pimm-machine.css' | asset_url }}&amp;pimm_release=pimm-master-20260901-r05-hdri-cycles-1&amp;pimm_ui=story-fill-v2" media="all">
{% if page_model == '30G' %}
  {{ 'maliev-pimm-30g-hero.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'pimm-support-motion.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'pimm-demo-invitation.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'maliev-pimm-hero-reveal.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'pimm-bento-orbit.js' | asset_url }}" defer="defer"></script>
{% endif %}
<script src="{{ 'maliev-pimm-machine.js' | asset_url }}&amp;pimm_release=pimm-master-20260901-r05-hdri-cycles-1&amp;pimm_ui=story-fill-v2" defer="defer"></script>

<pimm-machine-product
  class="pimm-machine"
  data-pimm-machine-product
  data-page-model="{{ page_model | escape }}"
  data-section-id="{{ section.id }}"
  data-model-contract-valid="{{ model_contract_valid }}"
>
  {% render 'pimm-hero-console',
    product: product,
    section: section,
    selected_model_code: selected_model_code,
    selected_variant: selected_variant,
    specifications: specifications,
    full_price_cents: selected_full_price_cents,
    lead_time: lead_time,
    model_contract_valid: model_contract_valid,
    factory_visit_url: factory_visit_url
  %}

  <main class="pimm-machine__stories" data-pimm-stories>
    {% unless page_model == '50G' %}
    <div
      data-pimm-story-model="30G"
      {% unless selected_model_code == '30G' and model_contract_valid %}hidden inert aria-hidden="true"{% else %}aria-hidden="false"{% endunless %}
    >
      {% render 'pimm-30g-product-story', story_asset_set: 'pimm-master-20260901-r05-30g' %}
    </div>
    {% endunless %}
    {% unless page_model == '30G' %}
    <div
      data-pimm-story-model="50G"
      {% unless selected_model_code == '50G' and model_contract_valid %}hidden inert aria-hidden="true"{% else %}aria-hidden="false"{% endunless %}
    >
      {% render 'pimm-50g-product-story', story_asset_set: 'pimm-master-20260901-r05-50g' %}
    </div>
    {% endunless %}
  </main>

  {% render 'pimm-ownership', section: section, page_model: page_model %}
  {% if page_model == '30G' %}
    {% render 'pimm-machine-gallery', section: section %}
  {% endif %}
  {% render 'pimm-purchase-qualification', selected_variant: selected_variant, model_contract_valid: model_contract_valid, section: section %}

  <script
    type="application/json"
    data-pimm-variant-data
    data-pimm-invalid-message="{{ 'products.pimm_machine.status.unavailable' | t | escape }}"
    data-pimm-taxes-included="{{ cart.taxes_included }}"
    data-pimm-country="{{ localization.country.iso_code | escape }}"
    data-pimm-currency="{{ cart.currency.iso_code | escape }}"
  >
    [
      {%- for variant in product.variants -%}
        {%- liquid
          assign variant_model = variant.option1 | strip
          assign variant_model_block = nil
          assign variant_model_block_count = 0
          for block in section.blocks
            if block.type == 'model' and block.settings.model_code == variant_model
              assign variant_model_block_count = variant_model_block_count | plus: 1
              if variant_model_block == nil
                assign variant_model_block = block
              endif
            endif
          endfor

          assign expected_variant_story_asset_set = ''
          case variant_model
            when '30G'
              assign expected_variant_story_asset_set = 'pimm-master-20260901-r05-30g'
            when '50G'
              assign expected_variant_story_asset_set = 'pimm-master-20260901-r05-50g'
          endcase
          assign variant_story_asset_set = expected_variant_story_asset_set
          assign variant_story_binding_valid = false
          if variant_model_block.settings.story_asset_set == blank or variant_model_block.settings.story_asset_set == expected_variant_story_asset_set
            assign variant_story_binding_valid = true
          endif
          assign variant_specifications = variant.metafields.custom.pimm_specifications.value
          assign variant_full_price = variant.metafields.custom.full_machine_price.value
          assign variant_full_price_cents = variant_full_price
          assign variant_lead_time_days = variant.metafields.custom.lead_time_days.value
          assign variant_contract_valid = false

          if product_model_contract_valid and variant_model_block != blank and variant_model_block_count == 1
            if variant_story_binding_valid and variant_specifications != blank
              if variant_specifications.schema_version == 1 and variant_specifications.model == variant_model
                if variant_specifications.shot_capacity_g > 0 and variant_specifications.max_melt_temperature_c > 0
                  if variant_specifications.max_air_pressure_mpa > 0 and variant_specifications.mold_envelope_mm.width > 0
                    if variant_specifications.mold_envelope_mm.height > 0 and variant_specifications.mold_envelope_mm.depth > 0
                      if variant_full_price != blank and variant_lead_time_days > 0
                        assign variant_contract_valid = true
                      endif
                    endif
                  endif
                endif
              endif
            endif
          endif

          assign variant_full_price_text = 'products.pimm_machine.status.unavailable' | t
          if variant_contract_valid
            assign variant_full_price_text = variant_full_price_cents | money_with_currency
          endif

          capture variant_lead_time_text
            if variant_lead_time_days > 0
              echo 'products.pimm_machine.purchase.lead_time' | t: days: variant_lead_time_days
            else
              echo 'products.pimm_machine.status.unavailable' | t
            endif
          endcapture

          assign variant_status_text = 'products.pimm_machine.status.unavailable' | t
          if variant_contract_valid
            if variant.available
              assign variant_status_text = 'products.pimm_machine.status.made_to_order' | t
            else
              assign variant_status_text = 'products.pimm_machine.status.out_of_stock' | t
            endif
          endif
        -%}
        {
          "id": {{ variant.id | json }},
          "model": {{ variant_model | strip_html | json }},
          "storyAssetSet": {{ variant_story_asset_set | json }},
          "fullPrice": {{ variant_full_price_text | strip_html | json }},
          "available": {{ variant.available | json }},
          "leadTime": {{ variant_lead_time_text | strip_html | strip | json }},
          "specifications": {
            {%- if variant_contract_valid -%}
              "schema_version": {{ variant_specifications.schema_version | plus: 0 | json }},
              "model": {{ variant_model | strip_html | json }},
              "shot_capacity_g": {{ variant_specifications.shot_capacity_g | plus: 0 | json }},
              "max_melt_temperature_c": {{ variant_specifications.max_melt_temperature_c | plus: 0 | json }},
              "mold_envelope_mm": {
                "width": {{ variant_specifications.mold_envelope_mm.width | plus: 0 | json }},
                "height": {{ variant_specifications.mold_envelope_mm.height | plus: 0 | json }},
                "depth": {{ variant_specifications.mold_envelope_mm.depth | plus: 0 | json }}
              },
              "max_air_pressure_mpa": {{ variant_specifications.max_air_pressure_mpa | plus: 0 | json }}
            {%- else -%}
              "schema_version": null,
              "model": null,
              "shot_capacity_g": null,
              "max_melt_temperature_c": null,
              "mold_envelope_mm": { "width": null, "height": null, "depth": null },
              "max_air_pressure_mpa": null
            {%- endif -%}
          },
          "statusText": {{ variant_status_text | strip_html | json }},
          "announcementText": {{ variant_status_text | strip_html | strip | json }},
          "contractValid": {{ variant_contract_valid | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
</pimm-machine-product>

{%- assign app_blocks = section.blocks | where: 'type', '@app' -%}
{%- if app_blocks.size > 0 -%}
  <aside class="pimm-machine__app-integrations" data-pimm-app-integrations aria-label="{{ 'products.pimm_machine.app_integrations' | t }}">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when '@app' -%}
          <div class="pimm-machine__app-block" {{ block.shopify_attributes }}>{% render block %}</div>
      {%- endcase -%}
    {%- endfor -%}
  </aside>
{%- endif -%}

{% schema %}
{
  "name": "PIMM machine product",
  "tag": "section",
  "class": "section-pimm-machine-product",
  "max_blocks": 50,
  "settings": [
    { "type": "select", "id": "page_model", "label": "Dedicated model page", "options": [{ "value": "shared", "label": "Shared configurator" }, { "value": "30G", "label": "30G" }, { "value": "50G", "label": "50G" }], "default": "shared" },
    { "type": "url", "id": "factory_visit_url", "label": "Demo session URL" },
    { "type": "url", "id": "document_url", "label": "Documentation URL" },
    { "type": "url", "id": "support_url", "label": "Support URL" }
  ],
  "blocks": [
    {
      "type": "model",
      "name": "Machine model",
      "limit": 2,
      "settings": [
        {
          "type": "select",
          "id": "model_code",
          "label": "Model",
          "options": [
            { "value": "30G", "label": "30G" },
            { "value": "50G", "label": "50G" }
          ],
          "default": "30G"
        },
        { "type": "text", "id": "story_asset_set", "label": "Governed story asset set" }
      ]
    },
    {
      "type": "gallery_video",
      "name": "Gallery video (30G)",
      "settings": [
        { "type": "video_url", "id": "external_video", "label": "Full YouTube video", "accept": ["youtube"] },
        { "type": "video", "id": "full_video", "label": "Full uploaded video", "info": "Used instead of YouTube when selected." },
        { "type": "video", "id": "preview_video", "label": "Muted preview clip", "info": "Upload your original clip to loop in the gallery. YouTube is only loaded when a visitor opens the full video." },
        { "type": "checkbox", "id": "use_default_preview", "label": "Use original MALIEV preview", "default": false, "info": "Available for the three original MALIEV YouTube videos only. A selected preview clip overrides it." },
        { "type": "number", "id": "preview_start", "label": "Preview start (seconds)", "default": 0 },
        { "type": "range", "id": "preview_length", "label": "Preview length", "min": 3, "max": 15, "step": 1, "unit": "s", "default": 6 },
        { "type": "image_picker", "id": "poster", "label": "Cover image" },
        { "type": "text", "id": "title", "label": "Caption", "info": "Leave blank to use the translated default caption." },
        { "type": "select", "id": "caption_key", "label": "Default caption", "options": [{ "value": "demonstration", "label": "Machine demonstration" }, { "value": "molding", "label": "Molding demonstration" }, { "value": "end_caps", "label": "Making aluminum profile end caps" }], "default": "demonstration" }
      ]
    },
    {
      "type": "gallery_image",
      "name": "Gallery image (30G)",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo", "info": "Select a real machine photo. No rendered image is added automatically." },
        { "type": "text", "id": "title", "label": "Caption", "info": "Describe the photo. Leave blank to use the translated default caption." }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [{ "name": "PIMM machine product" }]
}
{% endschema %}
