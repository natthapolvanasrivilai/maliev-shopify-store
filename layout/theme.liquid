         position: 'RIGHT_BOTTOM'
       });
      });
    </script>
    {%- if request.page_type == 'index' -%}
      {%- liquid
        assign maliev_home_logo_alt = settings.logo.alt | default: shop.name | escape
        capture maliev_home_logo_markup
          if settings.logo != blank
            echo settings.logo | image_url: width: 560 | image_tag: class: 'mh__title-logo', loading: 'eager', alt: maliev_home_logo_alt
          else
            echo '<span class="mh__title-logo-text">MALIEV</span>'
          endif
        endcapture
      -%}
      <style>
        #MainContent .mh__hero .mh__title {
          font-size: clamp(5.2rem, 6vw, 8.6rem) !important;
          line-height: 0.94 !important;
          max-width: 72rem !important;
          overflow-wrap: normal !important;
          text-wrap: balance;
          word-break: normal !important;
        }

        #MainContent .mh__hero .mh__title,
        #MainContent .mh__hero .mh__title * {
          hyphens: none !important;
          overflow-wrap: normal !important;
          word-break: normal !important;
        }

        #MainContent .mh__hero .mh__title-line {
          display: block;
          white-space: nowrap;
        }

        #MainContent .mh__hero .mh__title-line--brand {
          align-items: start !important;
          display: grid !important;
          gap: clamp(1.2rem, 1.4vw, 2.2rem) !important;
        }

        #MainContent .mh__hero .mh__title-logo {
          display: block !important;
          height: 0.58em !important;
          max-width: 3.1em !important;
          object-fit: contain !important;
          width: auto !important;
        }

        #MainContent .mh__hero .mh__title-logo-text {
          display: block !important;
          white-space: nowrap;
        }

        #MainContent .mh__product-track {
          cursor: grab;
          touch-action: pan-y;
          user-select: none;
        }

        #MainContent .mh__product-track.is-dragging {
          cursor: grabbing;
          scroll-snap-type: none;
        }

        #MainContent .mh__product-track img {
          pointer-events: none !important;
        }

        @media screen and (max-width: 640px) {
          #MainContent .mh__hero .mh__title {
            font-size: clamp(3.8rem, 11vw, 5.2rem) !important;
          }
        }
      </style>
      <script>
        (() => {
          const logoMarkup = {{ maliev_home_logo_markup | strip | json }};
          const renderHeroTitle = () => {
            const title = document.querySelector('#MainContent .mh__hero .mh__title');
            if (!title || title.querySelector('.mh__title-logo, .mh__title-logo-text')) return;

            const text = title.textContent.replace(/\s+/g, ' ').trim();
            if (text !== 'Machines, molds, and manufacturing support from MALIEV.') return;

            title.innerHTML = [
              '<span class="mh__title-line">Machines,</span>',
              '<span class="mh__title-line">molds, and</span>',
              '<span class="mh__title-line">manufacturing</span>',
              '<span class="mh__title-line mh__title-line--brand"><span>support from</span>' + logoMarkup + '</span>'
            ].join('');
          };

          const bindFeaturedMachineCarousel = () => {
            const track = document.querySelector('#MainContent .mh__product-track');
            if (!track || track.dataset.desktopDragBound === 'true') return;

            const slides = Array.from(document.querySelectorAll('#MainContent .mh__product-slide'));
            const dots = Array.from(document.querySelectorAll('#MainContent [data-carousel-dot]'));
            const previous = document.querySelector('#MainContent [data-carousel-prev]');
            const next = document.querySelector('#MainContent [data-carousel-next]');
            if (slides.length < 2) return;

            track.dataset.desktopDragBound = 'true';
            track.querySelectorAll('img').forEach((image) => image.setAttribute('draggable', 'false'));

            const getIndex = () => Math.max(0, Math.min(slides.length - 1, Math.round(track.scrollLeft / Math.max(1, track.clientWidth))));
            const update = () => {
              const activeIndex = getIndex();
              dots.forEach((dot, index) => {
                dot.classList.toggle('mh__carousel-dot--active', index === activeIndex);
                dot.setAttribute('aria-current', index === activeIndex ? 'true' : 'false');
              });
            };
            const goTo = (index, behavior = 'smooth') => {
              const targetIndex = (index + slides.length) % slides.length;
              track.scrollTo({ left: targetIndex * track.clientWidth, behavior });
              window.requestAnimationFrame(update);
            };

            dots.forEach((dot, index) => dot.addEventListener('click', () => goTo(index)));
            previous?.addEventListener('click', () => goTo(getIndex() - 1));
            next?.addEventListener('click', () => goTo(getIndex() + 1));

            let pointerDown = false;
            let startX = 0;
            let startLeft = 0;
            let didDrag = false;

            const startDrag = (event) => {
              if (pointerDown || (event.button !== undefined && event.button !== 0)) return;
              pointerDown = true;
              didDrag = false;
              startX = event.clientX;
              startLeft = track.scrollLeft;
              track.classList.add('is-dragging');
            };
            const moveDrag = (event) => {
              if (!pointerDown) return;
              const delta = event.clientX - startX;
              if (Math.abs(delta) > 4) didDrag = true;
              track.scrollLeft = startLeft - delta;
            };
            const endDrag = () => {
              if (!pointerDown) return;
              pointerDown = false;
              track.classList.remove('is-dragging');
              goTo(getIndex());
            };

            track.addEventListener('pointerdown', (event) => {
              startDrag(event);
              track.setPointerCapture?.(event.pointerId);
            });
            track.addEventListener('pointermove', moveDrag);
            track.addEventListener('pointerup', endDrag);
            track.addEventListener('pointercancel', endDrag);
            track.addEventListener('pointerleave', endDrag);
            track.addEventListener('dragstart', (event) => event.preventDefault());
            track.addEventListener('mousedown', startDrag);
            window.addEventListener('mousemove', moveDrag);
            window.addEventListener('mouseup', endDrag);
            track.addEventListener('click', (event) => {
              if (!didDrag) return;
              event.preventDefault();
              event.stopPropagation();
              didDrag = false;
            }, true);
            track.addEventListener('scroll', () => window.requestAnimationFrame(update), { passive: true });
            window.addEventListener('resize', () => goTo(getIndex(), 'auto'));
            update();
          };

          const replaceSimMountArtwork = () => {
            document.querySelectorAll('#MainContent img[src*="simmount-pro-vesa.15.png"], #MainContent img[src*="simmount-pro-vesa.6.png"]').forEach((image) => {
              const cardText = image.closest('.mh__mini-product, .mh__tile')?.textContent || '';
              const isEcosystem = cardText.includes('Mounting ecosystem') || cardText.includes('ระบบอุปกรณ์ยึด') || image.alt.toLowerCase().includes('ecosystem');
              image.src = isEcosystem
                ? 'https://shop.maliev.com/cdn/shop/files/simmount-pro-vesa.19.png?v=1736670814&width=750'
                : 'https://shop.maliev.com/cdn/shop/files/simmount-pro-vesa.6.png?v=1736670814&width=750';
              image.removeAttribute('srcset');
            });
          };

          const enhanceHome = () => {
            renderHeroTitle();
            bindFeaturedMachineCarousel();
            replaceSimMountArtwork();
          };

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', enhanceHome, { once: true });
          } else {
            enhanceHome();
          }
        })();
      </script>
    {%- endif -%}
    {%- if request.page_type == 'blog' -%}
      <style>
        #MainContent .main-blog {
          --blog-ink: #0f141b;
          --blog-muted: #596574;
          --blog-rule: rgba(15, 20, 27, 0.12);
          --blog-blue: #0072d8;
          color: var(--blog-ink);
        }

        #MainContent .newsletter {
          display: none !important;
        }

        #MainContent .main-blog__header {
          align-items: end;
          display: grid;
          gap: 2rem clamp(3rem, 7vw, 10rem);
          grid-template-columns: minmax(0, 1.25fr) minmax(26rem, 0.75fr);
          margin: clamp(3.2rem, 6vw, 7.2rem) 0 clamp(3rem, 5vw, 5.6rem);
        }

        #MainContent .main-blog__eyebrow {
          color: var(--blog-blue);
          font-size: 1.2rem;
          font-weight: 600;
          grid-column: 1 / -1;
          letter-spacing: 0.14em;
          line-height: 1;
          margin: 0 0 -0.6rem;
          text-transform: uppercase;
        }

        #MainContent .main-blog .title--primary {
          color: var(--blog-ink);
          display: block !important;
          font-size: clamp(4.8rem, 6vw, 8.8rem);
          font-weight: 600;
          letter-spacing: 0;
          line-height: 0.98;
          margin: 0;
          max-width: 9.5em;
          overflow-wrap: normal;
          text-wrap: balance;
          word-break: normal;
        }

        #MainContent .main-blog__lead {
          color: var(--blog-muted);
          font-size: clamp(1.7rem, 1.5vw, 2rem);
          line-height: 1.45;
          margin: 0;
          max-width: 44rem;
        }

        #MainContent .blog-articles {
          display: grid;
          gap: 1.6rem;
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        #MainContent .blog-articles__article.article {
          align-items: stretch;
          display: block;
          min-width: 0;
        }

        #MainContent .blog-articles .card {
          background: #ffffff;
          border: 1px solid var(--blog-rule);
          border-radius: 0 !important;
          overflow: hidden;
          transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
        }

        #MainContent .blog-articles .article-card-wrapper:hover .card,
        #MainContent .blog-articles .article-card-wrapper:focus-within .card {
          border-color: rgba(0, 114, 216, 0.35);
          box-shadow: 0 2rem 5rem rgba(15, 20, 27, 0.08);
          transform: translateY(-0.2rem);
        }

        #MainContent .blog-articles .card__inner,
        #MainContent .blog-articles .article-card__image-wrapper,
        #MainContent .blog-articles .article-card__image,
        #MainContent .blog-articles .article-card__image .media {
          border-radius: 0 !important;
          overflow: hidden;
        }

        #MainContent .blog-articles .article-card__image img {
          display: block;
          height: 100%;
          object-fit: cover;
          transform: scale(1);
          transition: transform 260ms ease;
          width: 100%;
        }

        #MainContent .blog-articles .article-card-wrapper:hover .article-card__image img,
        #MainContent .blog-articles .article-card-wrapper:focus-within .article-card__image img {
          transform: scale(1.035);
        }

        #MainContent .blog-articles .card__information {
          padding: 2rem 2rem 2.2rem;
        }

        #MainContent .blog-articles .card__heading {
          color: var(--blog-ink);
          font-size: clamp(2rem, 1.65vw, 2.8rem);
          font-weight: 600;
          letter-spacing: 0;
          line-height: 1.05;
          margin: 0 0 1rem;
          text-wrap: balance;
        }

        #MainContent .blog-articles .full-unstyled-link {
          font-weight: inherit;
          text-decoration: none;
        }

        #MainContent .blog-articles .article-card__info {
          color: var(--blog-blue);
          font-size: 1.1rem;
          font-weight: 600;
          letter-spacing: 0.12em;
          line-height: 1.35;
          padding-top: 0;
          text-transform: uppercase;
        }

        #MainContent .blog-articles .article-card__excerpt {
          color: var(--blog-muted);
          font-size: 1.45rem;
          line-height: 1.45;
          margin: 1.2rem 0 0;
          max-width: 62rem;
          width: 100%;
        }

        #MainContent .blog-articles--collage > *:nth-child(3n + 1),
        #MainContent .blog-articles--collage > *:nth-child(3n + 2):last-child {
          grid-column: span 2;
        }

        #MainContent .blog-articles--collage > *:nth-child(3n + 1) .card,
        #MainContent .blog-articles--collage > *:nth-child(3n + 2):last-child .card {
          display: grid;
          grid-template-columns: minmax(0, 1.1fr) minmax(32rem, 0.9fr);
        }

        #MainContent .blog-articles--collage > *:nth-child(3n + 1) .card__inner,
        #MainContent .blog-articles--collage > *:nth-child(3n + 2):last-child .card__inner {
          min-height: 38rem;
        }

        #MainContent .blog-articles--collage > *:nth-child(3n + 1) .card > .card__content,
        #MainContent .blog-articles--collage > *:nth-child(3n + 2):last-child .card > .card__content {
          align-items: center;
          display: flex;
        }

        #MainContent .blog-articles--collage > *:nth-child(3n + 1) .card__heading,
        #MainContent .blog-articles--collage > *:nth-child(3n + 2):last-child .card__heading {
          font-size: clamp(3rem, 3vw, 4.8rem);
        }

        @media screen and (max-width: 989px) {
          #MainContent .main-blog__header {
            align-items: start;
            grid-template-columns: 1fr;
          }

          #MainContent .blog-articles {
            grid-template-columns: repeat(2, minmax(0, 1fr));
          }

          #MainContent .blog-articles--collage > *:nth-child(3n + 1),
          #MainContent .blog-articles--collage > *:nth-child(3n + 2):last-child {
            grid-column: span 2;
          }

          #MainContent .blog-articles--collage > *:nth-child(3n + 1) .card,
          #MainContent .blog-articles--collage > *:nth-child(3n + 2):last-child .card {
            grid-template-columns: 1fr;
          }
        }

        @media screen and (max-width: 640px) {
          #MainContent .main-blog .title--primary {
            font-size: clamp(4rem, 13vw, 5.8rem);
          }

          #MainContent .blog-articles {
            grid-template-columns: 1fr;
          }

          #MainContent .blog-articles--collage > *:nth-child(3n + 1),
          #MainContent .blog-articles--collage > *:nth-child(3n + 2):last-child {
            grid-column: span 1;
          }

          #MainContent .blog-articles .card__heading,
          #MainContent .blog-articles--collage > *:nth-child(3n + 1) .card__heading,
          #MainContent .blog-articles--collage > *:nth-child(3n + 2):last-child .card__heading {
            font-size: clamp(2.4rem, 8vw, 3.4rem);
          }
        }
      </style>
      <script>
        (() => {
          const enhanceBlogIndex = () => {
            const main = document.querySelector('#MainContent .main-blog');
            if (!main || main.querySelector('.main-blog__header')) return;

            const title = main.querySelector(':scope > .title--primary');
            const articles = main.querySelector(':scope > .blog-articles');
            if (!title || !articles) return;

            const header = document.createElement('header');
            header.className = 'main-blog__header';
            header.innerHTML = '<p class="main-blog__eyebrow">MALIEV Journal</p>';
            const lead = document.createElement('p');
            lead.className = 'main-blog__lead';
            lead.textContent = 'Product guides, shop updates, and practical notes for compact manufacturing, machine work, and MALIEV hardware.';
            main.insertBefore(header, title);
            header.appendChild(title);
            header.appendChild(lead);
          };

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', enhanceBlogIndex, { once: true });
          } else {
            enhanceBlogIndex();
          }
        })();
      </script>
    {%- endif -%}
</head>

  <body
    class="gradient template-{{ template.name | handle }}{% if template.suffix %} template-{{ template.name | handle }}--{{ template.suffix | handle }}{% endif %}{% if settings.animations_hover_elements != 'none' %} animate--hover-{{ settings.animations_hover_elements }}{% endif %}"
    data-template="{{ template.name | escape }}"
    {% if template.suffix %}data-template-suffix="{{ template.suffix | escape }}"{% endif %}
  >
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-568NMRCL"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <a class="skip-to-content-link button visually-hidden" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    {%- if settings.cart_type == 'drawer' -%}
      {%- render 'cart-drawer' -%}
    {%- endif -%}

    {% sections 'header-group' %}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>

    <script>
      window.shopUrl = '{{ request.origin }}';
      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_url: '{{ routes.cart_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}',
      };

      window.cartStrings = {
        error: `{{ 'sections.cart.cart_error' | t }}`,
        quantityError: `{{ 'sections.cart.cart_quantity_error_html' | t: quantity: '[quantity]' }}`,
      };

      window.variantStrings = {
        addToCart: `{{ 'products.product.add_to_cart' | t }}`,
        soldOut: `{{ 'products.product.sold_out' | t }}`,
        unavailable: `{{ 'products.product.unavailable' | t }}`,
        unavailable_with_option: `{{ 'products.product.value_unavailable' | t: option_value: '[value]' }}`,
      };

      window.quickOrderListStrings = {
        itemsAdded: `{{ 'sections.quick_order_list.items_added.other' | t: quantity: '[quantity]' }}`,
        itemAdded: `{{ 'sections.quick_order_list.items_added.one' | t: quantity: '[quantity]' }}`,
        itemsRemoved: `{{ 'sections.quick_order_list.items_removed.other' | t: quantity: '[quantity]' }}`,
        itemRemoved: `{{ 'sections.quick_order_list.items_removed.one' | t: quantity: '[quantity]' }}`,
        viewCart: `{{- 'sections.quick_order_list.view_cart' | t -}}`,
        each: `{{- 'sections.quick_order_list.each' | t: money: '[money]' }}`,
        min_error: `{{- 'sections.quick_order_list.min_error' | t: min: '[min]' }}`,
        max_error: `{{- 'sections.quick_order_list.max_error' | t: max: '[max]' }}`,
        step_error: `{{- 'sections.quick_order_list.step_error' | t: step: '[step]' }}`,
      };

      window.accessibilityStrings = {
        imageAvailable: `{{ 'products.product.media.image_available' | t: index: '[index]' }}`,
        shareSuccess: `{{ 'general.share.success_message' | t }}`,
        pauseSlideshow: `{{ 'sections.slideshow.pause_slideshow' | t }}`,
        playSlideshow: `{{ 'sections.slideshow.play_slideshow' | t }}`,
        recipientFormExpanded: `{{ 'recipient.form.expanded' | t }}`,
        recipientFormCollapsed: `{{ 'recipient.form.collapsed' | t }}`,
        countrySelectorSearchCount: `{{ 'localization.country_results_count' | t: count: '[count]' }}`,
      };
    </script>

    {%- if settings.predictive_search_enabled -%}
      <script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- if settings.cart_type == 'drawer' -%}
      <script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
  </body>
</html>

