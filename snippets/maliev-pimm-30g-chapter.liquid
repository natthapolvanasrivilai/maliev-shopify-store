{% doc %}
  Renders one responsive media layer for the PIMM 30G story.

  @param {object} block - Chapter block containing the desktop and mobile media settings.
  @param {string} chapter_id - Stable chapter anchor used to synchronize the stage and content.
  @param {string} media_alt - Resolved, localized alternative text for the poster image.
  @param {string} mode - Either "stage" for the sticky presentation or "static" for no-JavaScript output.
  @param {boolean} eager - Loads the overview poster eagerly when true.
{% enddoc %}

{%- liquid
  assign desktop_poster_url = blank
  assign mobile_poster_url = blank
  assign poster_width = 2400
  assign poster_loading = 'lazy'

  if eager
    assign poster_loading = 'eager'
  endif

  if block.settings.desktop_poster != blank
    assign desktop_poster_url = block.settings.desktop_poster | image_url: width: poster_width
  elsif block.settings.desktop_poster_asset != blank
    assign desktop_poster_url = block.settings.desktop_poster_asset | asset_url
  endif

  if block.settings.mobile_poster != blank
    assign mobile_poster_url = block.settings.mobile_poster | image_url: width: 1400
  elsif block.settings.mobile_poster_asset != blank
    assign mobile_poster_url = block.settings.mobile_poster_asset | asset_url
  else
    assign mobile_poster_url = desktop_poster_url
  endif

  assign has_desktop_video = false
  assign has_mobile_video = false
  assign desktop_asset_mime = 'video/mp4'
  assign mobile_asset_mime = 'video/mp4'
  if block.settings.desktop_video != blank or block.settings.desktop_video_asset != blank
    assign has_desktop_video = true
  endif
  if block.settings.mobile_video != blank or block.settings.mobile_video_asset != blank
    assign has_mobile_video = true
  endif
  if block.settings.desktop_video_asset contains '.webm'
    assign desktop_asset_mime = 'video/webm'
  endif
  if block.settings.mobile_video_asset contains '.webm'
    assign mobile_asset_mime = 'video/webm'
  endif
-%}

{%- if mode == 'static' -%}
  <picture class="pimm30-chapter-media pimm30-chapter-media--static">
    {%- if mobile_poster_url != blank -%}<source media="(max-width: 749px)" srcset="{{ mobile_poster_url }}">{%- endif -%}
    {%- if desktop_poster_url != blank -%}
      <img src="{{ desktop_poster_url }}" alt="{{ media_alt | escape }}" loading="{{ poster_loading }}" width="1800" height="2200">
    {%- endif -%}
  </picture>
{%- else -%}
  <figure
    class="pimm30-stage__layer{% if eager %} is-active{% endif %}"
    data-pimm30-layer="{{ chapter_id }}"
    {% if block.settings.role == 'configuration' %}
      data-pimm30-turntable
      role="group"
      tabindex="-1"
      aria-label="{{ media_alt | escape }}. {% if localization.language.iso_code contains 'th' %}ลากไปทางซ้ายหรือขวาเพื่อหมุนดูเครื่อง{% else %}Drag left or right to rotate the machine{% endif %}."
    {% endif %}
    aria-hidden="{% if eager %}false{% else %}true{% endif %}"
  >
    <picture class="pimm30-stage__poster">
      {%- if mobile_poster_url != blank -%}<source media="(max-width: 749px)" srcset="{{ mobile_poster_url }}">{%- endif -%}
      {%- if desktop_poster_url != blank -%}
        <img src="{{ desktop_poster_url }}" alt="{{ media_alt | escape }}" loading="{{ poster_loading }}" width="1800" height="2200">
      {%- endif -%}
    </picture>

    {%- if has_desktop_video -%}
      <video
        class="pimm30-stage__video pimm30-stage__video--desktop{% unless has_mobile_video %} pimm30-stage__video--all-devices{% endunless %}"
        data-pimm30-video
        muted
        playsinline
        preload="{% if eager %}metadata{% else %}none{% endif %}"
      >
        {%- if block.settings.desktop_video != blank -%}
          {%- for source in block.settings.desktop_video.sources -%}
            <source src="{{ source.url }}" type="{{ source.mime_type }}">
          {%- endfor -%}
        {%- else -%}
          <source src="{{ block.settings.desktop_video_asset | asset_url }}" type="{{ desktop_asset_mime }}">
        {%- endif -%}
      </video>
    {%- endif -%}

    {%- if has_mobile_video -%}
      <video
        class="pimm30-stage__video pimm30-stage__video--mobile"
        data-pimm30-video
        muted
        playsinline
        preload="{% if eager %}metadata{% else %}none{% endif %}"
      >
        {%- if block.settings.mobile_video != blank -%}
          {%- for source in block.settings.mobile_video.sources -%}
            <source src="{{ source.url }}" type="{{ source.mime_type }}">
          {%- endfor -%}
        {%- else -%}
          <source src="{{ block.settings.mobile_video_asset | asset_url }}" type="{{ mobile_asset_mime }}">
        {%- endif -%}
      </video>
    {%- endif -%}

    {%- if block.settings.role == 'configuration' -%}
      <span class="pimm30-stage__turntable-hint" aria-hidden="true">
        {% if localization.language.iso_code contains 'th' %}ลากเพื่อหมุนดูเครื่อง{% else %}Drag to rotate{% endif %}
      </span>
    {%- endif -%}
  </figure>
{%- endif -%}
