{% comment %}
  MALIEV cart page line items. IDs, data attributes, custom elements, live
  regions, and js-contents boundaries are Shopify cart.js update contracts.
{% endcomment %}

{{ 'component-cart.css' | asset_url | stylesheet_tag }}
{{ 'component-cart-items.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-discounts.css' | asset_url | stylesheet_tag }}

{%- unless settings.cart_type == 'drawer' -%}<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>{%- endunless -%}

{%- style -%}
  #shopify-section-{{ section.id }} .mc-cart-page {
    padding-block: {{ section.settings.padding_top | times: 0.75 | round }}px {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .mc-cart-page { padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px; }
  }
{%- endstyle -%}

<cart-items class="mc-cart-page color-{{ section.settings.color_scheme }}{% if cart == empty %} is-empty{% endif %}">
  <div class="page-width">
    <header class="mc-cart-page__header">
      <div>
        <p class="mc-cart-page__eyebrow">MALIEV</p>
        <h1>{{ 'sections.cart.title' | t }}</h1>
      </div>
      <a href="{{ routes.all_products_collection_url }}" class="mc-cart-page__continue">{{ 'general.continue_shopping' | t }} <span aria-hidden="true">→</span></a>
    </header>

    <div class="cart__warnings mc-cart-empty">
      <h2 class="cart__empty-text">{{ 'sections.cart.empty' | t }}</h2>
      <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'general.continue_shopping' | t }}</a>
      {%- if shop.customer_accounts_enabled and customer == null -%}
        <p class="cart__login-title h3">{{ 'sections.cart.login.title' | t }}</p>
        <p class="cart__login-paragraph">{{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}</p>
      {%- endif -%}
    </div>

    <form action="{{ routes.cart_url }}" class="cart__contents critical-hidden" method="post" id="cart">
      <div class="cart__items" id="main-cart-items" data-id="{{ section.id }}">
        <div class="js-contents">
          {%- if cart != empty -%}
            <div class="mc-cart-list" role="list">
              {%- for item in cart.items -%}
                {%- assign line_index = item.index | plus: 1 -%}
                <article class="cart-item mc-cart-line" id="CartItem-{{ line_index }}" role="listitem">
                  <a href="{{ item.url }}" class="mc-cart-line__media" tabindex="-1" aria-hidden="true">
                    {%- if item.image -%}
                      {{ item.image | image_url: width: 360 | image_tag: loading: 'lazy', widths: '120, 180, 240, 360', class: 'cart-item__image', alt: item.image.alt }}
                    {%- else -%}
                      {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                  </a>

                  <div class="cart-item__details mc-cart-line__details">
                    {%- if settings.show_vendor -%}<p class="mc-cart-line__vendor">{{ item.product.vendor }}</p>{%- endif -%}
                    <a href="{{ item.url }}" class="cart-item__name mc-cart-line__name">{{ item.product.title | escape }}</a>
                    <p class="mc-cart-line__unit-price">
                      {%- if item.original_price != item.final_price -%}<s>{{ item.original_price | money }}</s> <strong>{{ item.final_price | money }}</strong>{%- else -%}{{ item.original_price | money }}{%- endif -%}
                    </p>

                    {%- if item.product.has_only_default_variant == false or item.properties.size > 0 or item.selling_plan_allocation -%}
                      <dl class="mc-cart-line__options">
                        {%- unless item.product.has_only_default_variant -%}
                          {%- for option in item.options_with_values -%}<div><dt>{{ option.name }}:</dt><dd>{{ option.value }}</dd></div>{%- endfor -%}
                        {%- endunless -%}
                        {%- for property in item.properties -%}
                          {%- assign first_character = property.first | slice: 0 -%}
                          {%- if property.last != blank and first_character != '_' -%}
                            <div><dt>{{ property.first }}:</dt><dd>{%- if property.last contains '/uploads/' -%}<a href="{{ property.last }}" target="_blank">{{ property.last | split: '/' | last }}</a>{%- else -%}{{ property.last }}{%- endif -%}</dd></div>
                          {%- endif -%}
                        {%- endfor -%}
                        {%- if item.selling_plan_allocation -%}<div><dt>{{ item.selling_plan_allocation.selling_plan.name }}</dt></div>{%- endif -%}
                      </dl>
                    {%- endif -%}

                    {%- if item.line_level_discount_allocations.size > 0 -%}
                      <ul class="discounts list-unstyled" role="list">{%- for discount in item.line_level_discount_allocations -%}<li>{{ 'icon-discount.svg' | inline_asset_content }} {{ discount.discount_application.title | escape }}</li>{%- endfor -%}</ul>
                    {%- endif -%}
                  </div>

                  <div class="cart-item__quantity mc-cart-line__quantity">
                    <label class="visually-hidden" for="Quantity-{{ line_index }}">{{ 'products.product.quantity.label' | t }}</label>
                    <quantity-input class="quantity cart-quantity">
                      <button class="quantity__button" name="minus" type="button"><span class="visually-hidden">{{ 'products.product.quantity.decrease' | t: product: item.product.title | escape }}</span>{{ 'icon-minus.svg' | inline_asset_content }}</button>
                      <input class="quantity__input" data-quantity-variant-id="{{ item.variant.id }}" type="number" name="updates[]" value="{{ item.quantity }}" data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}" min="0" data-min="{{ item.variant.quantity_rule.min }}" {% if item.variant.quantity_rule.max != null %}max="{{ item.variant.quantity_rule.max }}"{% endif %} step="{{ item.variant.quantity_rule.increment }}" aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}" id="Quantity-{{ line_index }}" data-index="{{ line_index }}">
                      <button class="quantity__button" name="plus" type="button"><span class="visually-hidden">{{ 'products.product.quantity.increase' | t: product: item.product.title | escape }}</span>{{ 'icon-plus.svg' | inline_asset_content }}</button>
                    </quantity-input>
                    <cart-remove-button id="Remove-{{ line_index }}" data-index="{{ line_index }}"><a href="{{ item.url_to_remove }}" class="mc-cart-line__remove" aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}">{{ 'icon-remove.svg' | inline_asset_content }}</a></cart-remove-button>
                    <div id="Line-item-error-{{ line_index }}" class="cart-item__error" role="alert"><small class="cart-item__error-text"></small></div>
                  </div>

                  <div class="cart-item__totals mc-cart-line__total right">
                    <span class="loading__spinner hidden">{% render 'loading-spinner' %}</span>
                    <strong>{{ item.final_line_price | money }}</strong>
                  </div>
                </article>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>
      <p class="visually-hidden" id="cart-live-region-text" aria-live="polite" role="status"></p>
      <p class="visually-hidden" id="shopping-cart-line-item-status" aria-live="polite" aria-hidden="true" role="status">{{ 'accessibility.loading' | t }}</p>
    </form>
  </div>
</cart-items>
