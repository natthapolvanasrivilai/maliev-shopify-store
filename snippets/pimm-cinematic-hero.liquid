{% doc %}Six slow, component-anchored native camera studies over localized typography.{% enddoc %}
<pimm-cinematic-hero>
  <img src="{{ 'pimm-cinematic-r59-complete.webp' | asset_url }}" alt="{{ 'products.pimm_machine.alt.30g.hero' | t | escape }}" width="960" height="1080" loading="eager" fetchpriority="high">
  {% assign cinematic_shots = 'cylinder,temperature,pressure,mounting,actuator,complete' | split: ',' %}
  {% for shot in cinematic_shots %}
    {% assign cinematic_asset = 'pimm-cinematic-r59-' | append: shot | append: '.webm' %}
    <video data-src="{{ cinematic_asset | asset_url }}" crossorigin="anonymous" muted playsinline preload="none" aria-hidden="true"></video>
  {% endfor %}
</pimm-cinematic-hero>
