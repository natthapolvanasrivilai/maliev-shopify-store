{% doc %}
  Renders the native 30G/50G variant selector for the unified PIMM product form.

  @param {product} product - The unified PIMM product.
  @param {object} selected_variant - The initially selected Shopify variant.
  @param {section} section - The owning machine-product section.
{% enddoc %}

<fieldset class="pimm-machine__model-selector" data-pimm-model-selector>
  <legend>{{ 'products.pimm_machine.model_selector.legend' | t }}</legend>
  <output
    class="pimm-machine__selected-model"
    data-pimm-selected-model
    aria-label="{{ 'products.pimm_machine.model_selector.selected_model' | t }}"
  >{{ selected_variant.option1 | escape }}</output>
  <div class="pimm-machine__model-options">
    {%- for variant in product.variants -%}
      {%- if variant.option1 == '30G' or variant.option1 == '50G' -%}
        {%- liquid
          assign model_label = 'products.pimm_machine.model_selector.models.30g' | t
          if variant.option1 == '50G'
            assign model_label = 'products.pimm_machine.model_selector.models.50g' | t
          endif
        -%}
        <label class="pimm-machine__model-option" for="PimmModel-{{ section.id }}-{{ variant.id }}">
          <input
            id="PimmModel-{{ section.id }}-{{ variant.id }}"
            type="radio"
            name="pimm-model"
            value="{{ variant.id }}"
            data-pimm-model-radio
            data-model="{{ variant.option1 | escape }}"
            {% if variant.id == selected_variant.id %}checked{% endif %}
          >
          <span class="pimm-machine__model-name">{{ model_label }}</span>
          {%- assign model_full_price = variant.metafields.custom.full_machine_price.value -%}
          <span class="pimm-machine__model-price">{{ model_full_price | money_with_currency }}</span>
        </label>
      {%- endif -%}
    {%- endfor -%}
  </div>
</fieldset>
