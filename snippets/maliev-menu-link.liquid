{%- liquid
  assign detail_block = nil
  assign menu_link_key = menu_link.title | handleize

  for detail in section.blocks
    assign detail_key = detail.settings.link_title | handleize
    if detail.type == 'menu_detail' and detail_key == menu_link_key
      assign detail_block = detail
      break
    endif
  endfor

  assign link_description = detail_block.settings.description
  if request.locale.iso_code == 'th' and detail_block.settings.description_th != blank
    assign link_description = detail_block.settings.description_th
  endif
  if link_description == blank and menu_link.object != blank
    assign link_description = menu_link.object.description | default: menu_link.object.content | strip_html | truncatewords: 18
  endif

  assign preset_asset = blank
  case detail_block.settings.image_preset
    when 'nav-products'
      assign preset_asset = 'maliev-nav-preview-products-20260905.webp'
    when 'nav-collections'
      assign preset_asset = 'maliev-nav-preview-collections-20260905.webp'
    when 'nav-simmount'
      assign preset_asset = 'maliev-nav-preview-simmount-20260905.webp'
    when 'nav-printed-items'
      assign preset_asset = 'maliev-nav-preview-3d-printed-items-20260905.webp'
    when 'nav-3d-printing'
      assign preset_asset = 'maliev-nav-preview-3d-printing-services-20260905.webp'
    when 'nav-cnc'
      assign preset_asset = 'maliev-nav-preview-cnc-machining-20260905.webp'
    when 'nav-scanning'
      assign preset_asset = 'maliev-nav-preview-3d-scanning-20260905.webp'
    when 'nav-documents'
      assign preset_asset = 'maliev-nav-preview-product-documents-20260905.webp'
    when 'nav-spares'
      assign preset_asset = 'maliev-nav-preview-spare-parts-20260905.webp'
    when 'nav-contact'
      assign preset_asset = 'maliev-nav-preview-contact-20260905.webp'
    when 'nav-mesh'
      assign preset_asset = 'maliev-nav-preview-mesh-splitter-20260905.webp'
    when 'nav-news'
      assign preset_asset = 'maliev-nav-preview-news-20260905.webp'
    when 'machines'
      assign preset_asset = 'maliev-homepage-pimm-20260901-r14-navigation-alpha.webp'
    when 'simmount'
      assign preset_asset = 'maliev-catalogue-simmount.webp'
    when 'printed'
      assign preset_asset = 'maliev-catalogue-3d-printed.webp'
    when 'molds'
      assign preset_asset = 'maliev-catalogue-molds-parts.webp'
    when 'mesh'
      assign preset_asset = 'maliev-catalogue-mesh-splitter.webp'
    when 'materials'
      assign preset_asset = 'maliev-catalogue-molding-materials.webp'
    when 'digital'
      assign preset_asset = 'maliev-catalogue-digital-files.webp'
  endcase

  assign link_image = detail_block.settings.image
  if link_image == blank and preset_asset == blank
    assign link_image = menu_link.object.featured_image
  endif
  assign has_link_image = false
  if link_image != blank or preset_asset != blank
    assign has_link_image = true
  endif

  if link_image != blank
    assign preview_image_url = link_image | image_url: width: 640
  elsif preset_asset != blank
    assign preview_image_url = preset_asset | asset_url
  else
    assign preview_image_url = 'maliev-catalogue-manufacturing-services.webp' | asset_url
  endif

  assign show_link_image = false
  if has_link_image and variant != 'compact'
    assign show_link_image = true
  endif
-%}

<a
  class="mc-menu-link mc-menu-link--{{ variant }}{% if show_link_image %} mc-menu-link--with-media{% endif %}"
  href="{{ menu_link.url }}"
  {% if menu_link.current %}aria-current="page"{% endif %}
  {% if variant == 'compact' %}
    data-mc-menu-preview
    data-preview-title="{{ menu_link.title | escape }}"
    data-preview-description="{{ link_description | strip_html | escape }}"
    data-preview-url="{{ menu_link.url | escape }}"
    data-preview-image="{{ preview_image_url | escape }}"
  {% endif %}
>
  {%- if show_link_image -%}
    <span class="mc-menu-link__media" aria-hidden="true">
      {%- if link_image != blank -%}
        {{
          link_image
          | image_url: width: 360
          | image_tag:
            widths: '120, 180, 240, 360',
            sizes: '(max-width: 1099px) 56px, 320px',
            loading: 'lazy',
            alt: ''
        }}
      {%- else -%}
        <img
          src="{{ preset_asset | asset_url }}"
          alt=""
          width="960"
          height="720"
          loading="lazy"
        >
      {%- endif -%}
    </span>
  {%- endif -%}
  <span class="mc-menu-link__copy">
    <span class="mc-menu-link__title">{{ menu_link.title | escape }}</span>
    {%- if link_description != blank -%}
      <span class="mc-menu-link__description">{{ link_description | strip_html | escape }}</span>
    {%- endif -%}
  </span>
  {%- if show_arrow -%}
    <svg class="mc-menu-link__arrow" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 6l4 4-4 4"/></svg>
  {%- endif -%}
</a>
