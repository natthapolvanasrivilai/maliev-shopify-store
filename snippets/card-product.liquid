{% doc %}
Renders a MALIEV product card while preserving Shopify price, availability, rating, and product-form contracts.

@param {product} card_product - Product to render.
@param {string} [media_aspect_ratio] - Product media ratio.
@param {boolean} [show_secondary_image] - Whether to show a secondary image on hover.
@param {boolean} [show_vendor] - Whether to show the product vendor.
@param {boolean} [show_rating] - Whether to show the product rating.
@param {boolean} [lazy_load] - Whether to lazy-load the primary image.
@param {string} [quick_add] - Quick-add behavior.
@param {string} [section_id] - Owning section identifier.
@param {boolean} [catalog_layout] - Whether the card is rendered in a collection catalog.
@param {string} [horizontal_class] - Optional horizontal card class trigger.
@param {string} [placeholder_image] - Optional Shopify placeholder image name.
{% enddoc %}

{%- liquid
  assign product_card = card_product
  assign card_title = product_card.title
  assign product_id_string = product_card.id | append: ''
  assign product_price_string = product_card.price | append: ''
  assign product_tags = product_card.tags | join: '|' | downcase | prepend: '|' | append: '|'
  assign is_pimm_50g = false
  assign show_new_badge = false
  assign show_best_selling_badge = false
  assign image_ratio = 1

  if product_id_string == '10311028408599' or product_price_string == '17000000'
    assign is_pimm_50g = true
  endif

  if is_pimm_50g and request.locale.iso_code contains 'th'
    assign card_title = 'เครื่องฉีดพลาสติกระบบลม 50g'
  endif

  if is_pimm_50g or product_tags contains '|new|'
    assign show_new_badge = true
  endif

  if product_tags contains '|best selling|' or product_tags contains '|best seller|' or product_tags contains '|bestseller|'
    assign show_best_selling_badge = true
  endif

  if product_card.featured_media and media_aspect_ratio == 'portrait'
    assign image_ratio = 0.8
  elsif product_card.featured_media and media_aspect_ratio == 'adapt'
    assign image_ratio = product_card.featured_media.aspect_ratio
  endif

  if image_ratio == 0 or image_ratio == blank
    assign image_ratio = 1
  endif

  assign card_loading = 'lazy'
  if lazy_load == false
    assign card_loading = 'eager'
  endif

  assign card_sizes = '(min-width: 1440px) 320px, (min-width: 990px) calc((100vw - 160px) / 4), (min-width: 750px) calc((100vw - 104px) / 3), calc(100vw - 40px)'
  if catalog_layout
    assign card_sizes = '(max-width: 749px) 120px, (min-width: 1440px) 320px, (min-width: 990px) calc((100vw - 360px) / 3), (min-width: 750px) calc((100vw - 72px) / 2)'
  endif
  assign card_form_id = 'maliev-card-form-' | append: section_id | append: '-' | append: product_card.id
  assign card_summary = product_card.metafields.descriptors.subtitle
  if card_summary == blank
    assign card_summary = product_card.description | strip_html | strip
  endif
  assign card_details = product_card.metafields.custom.card_details.value
-%}

{%- if product_card and product_card != empty -%}
  <article
    class="mc-product-card{% if horizontal_class %} mc-product-card--horizontal{% endif %}{% if catalog_layout %} mc-product-card--catalog{% endif %}"
    data-product-card
  >
    <div class="mc-product-card__media">
      <span class="mc-product-card__media-frame" style="--mc-card-ratio: {{ 1 | divided_by: image_ratio | times: 100 }}%;">
        {%- if product_card.featured_media -%}
          {{
            product_card.featured_media
            | image_url: width: 1200
            | image_tag:
              class: 'mc-product-card__image mc-product-card__image--primary',
              widths: '240, 360, 480, 640, 800, 960, 1200',
              sizes: card_sizes,
              loading: card_loading,
              alt: product_card.featured_media.alt
          }}

          {%- if show_secondary_image and product_card.media[1] != blank -%}
            {{
              product_card.media[1]
              | image_url: width: 1200
              | image_tag:
                class: 'mc-product-card__image mc-product-card__image--secondary',
                widths: '240, 360, 480, 640, 800, 960, 1200',
                sizes: card_sizes,
                loading: 'lazy',
                alt: ''
            }}
          {%- endif -%}
        {%- else -%}
          {{ placeholder_image | default: 'product-apparel-2' | placeholder_svg_tag: 'mc-product-card__placeholder' }}
        {%- endif -%}
      </span>

      {%- if show_new_badge or show_best_selling_badge or product_card.available == false -%}
        <span class="mc-product-card__badges" aria-label="{{ 'products.product.badges.label' | t }}">
          {%- if product_card.available == false -%}
            <span class="mc-product-card__badge">{{ 'products.product.sold_out' | t }}</span>
          {%- elsif show_new_badge -%}
            <span class="mc-product-card__badge">{{ 'products.product.badges.new' | t }}</span>
          {%- endif -%}
          {%- if show_best_selling_badge -%}
            <span class="mc-product-card__badge">{{ 'products.product.badges.best_seller' | t }}</span>
          {%- endif -%}
        </span>
      {%- endif -%}
    </div>

    <div class="mc-product-card__body">
      <div class="mc-product-card__meta">
        {%- if product_card.type != blank -%}
          <span class="mc-product-card__category">{{ product_card.type | escape }}</span>
        {%- endif -%}
        <span class="mc-product-card__availability{% unless product_card.available %} mc-product-card__availability--unavailable{% endunless %}">
          {%- if product_card.available -%}
            {{ 'products.product.inventory_in_stock' | t }}
          {%- else -%}
            {{ 'products.product.inventory_out_of_stock' | t }}
          {%- endif -%}
        </span>
      </div>

      {%- if show_vendor -%}
        <p class="mc-product-card__vendor">{{ product_card.vendor | escape }}</p>
      {%- endif -%}

      <h3 class="mc-product-card__title">
        <a href="{{ product_card.url }}">{{ card_title | escape }}</a>
      </h3>

      {%- if card_summary != blank -%}
        <p class="mc-product-card__subtitle">{{ card_summary | truncatewords: 18 | escape_once }}</p>
      {%- endif -%}

      {%- if catalog_layout and card_details != blank -%}
        <ul class="mc-product-card__details" role="list">
          {%- for card_detail in card_details limit: 2 -%}
            <li>{{ card_detail | escape }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="mc-product-card__price">
        {% render 'price', product: product_card, price_class: '', show_compare_at_price: true %}
      </div>

      {%- if show_rating and product_card.metafields.reviews.rating.value != blank -%}
        {%- liquid
          assign rating_value = product_card.metafields.reviews.rating.value.rating
          assign rating_max = product_card.metafields.reviews.rating.value.scale_max
          assign rating_count = product_card.metafields.reviews.rating_count
        -%}
        <p class="mc-product-card__rating" aria-label="{{ rating_value }} out of {{ rating_max }} stars">
          <span aria-hidden="true">★ {{ rating_value }}</span>
          {%- if rating_count != blank -%}<span>({{ rating_count }})</span>{%- endif -%}
        </p>
      {%- endif -%}

      {%- if quick_add != 'none' -%}
        <div class="mc-product-card__action">
          {%- if product_card.available == false -%}
            <button class="button button--secondary" type="button" disabled>
              {{ 'products.product.sold_out' | t }}
            </button>
          {%- elsif product_card.has_only_default_variant -%}
            <product-form data-section-id="{{ section_id }}">
              {%- form 'product', product_card, id: card_form_id, class: 'mc-product-card__form', novalidate: 'novalidate' -%}
                <input type="hidden" name="id" value="{{ product_card.selected_or_first_available_variant.id }}">
                <button
                  id="{{ card_form_id }}-submit"
                  class="button button--secondary"
                  type="submit"
                  name="add"
                  aria-label="{{ 'products.product.add_to_cart' | t }} — {{ card_title | escape }}"
                >
                  <span>{{ 'products.product.add_to_cart' | t }}</span>
                  {%- render 'loading-spinner' -%}
                </button>
                <div class="product-form__error-message-wrapper" role="alert" hidden>
                  <span class="product-form__error-message"></span>
                </div>
              {%- endform -%}
            </product-form>
          {%- else -%}
            <a class="button button--secondary" href="{{ product_card.url }}">
              {{ 'products.product.choose_options' | t }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </article>
{%- else -%}
  <article class="mc-product-card mc-product-card--placeholder" aria-hidden="true">
    <div class="mc-product-card__media">
      <span class="mc-product-card__media-frame" style="--mc-card-ratio: 100%;">
        {{ placeholder_image | default: 'product-apparel-2' | placeholder_svg_tag: 'mc-product-card__placeholder' }}
      </span>
    </div>
    <div class="mc-product-card__body">
      <h3 class="mc-product-card__title">{{ 'onboarding.product_title' | t }}</h3>
      {% render 'price', placeholder: true %}
    </div>
  </article>
{%- endif -%}
