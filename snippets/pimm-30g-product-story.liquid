{% doc %}
  Renders the PIMM 30G feature bento with four native Blender renders.

  @param {string} story_asset_set
{% enddoc %}

{% if story_asset_set == 'pimm-master-20260901-r05-30g' %}
  <section class="pimm-story pimm-story--30g" aria-label="{{ 'products.pimm_machine.editorial.heading' | t | escape }} — 30G">
    <header class="pimm-story__intro">
      <h2>{{ 'products.pimm_machine.fit.heading' | t }}</h2>
      <p>{{ 'products.pimm_machine.fit.body' | t }}</p>
    </header>

    <div class="pimm-bento">
      <article class="pimm-bento__tile pimm-bento__tile--render pimm-bento__tile--capacity">
        <figure class="pimm-bento__media"><img src="{{ 'pimm-bento-20260903-r06-30g-capacity.webp' | asset_url }}" alt="{{ 'products.pimm_machine.alt.30g.overview' | t | escape }}" width="1600" height="2200" loading="lazy" decoding="async"></figure>
        <div class="pimm-bento__copy"><h3>{{ 'products.pimm_machine.specs.capacity.label' | t }}</h3><p>{{ 'products.pimm_machine.specs.capacity.guidance' | t }}</p></div>
      </article>

      <article class="pimm-bento__tile pimm-bento__tile--render pimm-bento__tile--controls">
        <div class="pimm-bento__copy"><h3>{{ 'products.pimm_machine.hero.engineering_detail' | t }}</h3><p><span class="pimm-bento__text-full">{{ 'products.pimm_machine.engineering.body' | t }}</span><span class="pimm-bento__text-compact">{{ 'pimm_bento.controls_compact' | t }}</span></p></div>
        <figure class="pimm-bento__media"><img src="{{ 'pimm-bento-20260903-r06-30g-controls.webp' | asset_url }}" alt="{{ 'products.pimm_machine.alt.30g.engineering' | t | escape }}" width="2400" height="1200" loading="lazy" decoding="async"></figure>
      </article>

      <article class="pimm-bento__tile pimm-bento__tile--render pimm-bento__tile--tooling">
        <div class="pimm-bento__copy"><h3>{{ 'products.pimm_machine.tooling.heading' | t }}</h3><p><span class="pimm-bento__text-full">{{ 'products.pimm_machine.tooling.body' | t }}</span><span class="pimm-bento__text-compact">{{ 'pimm_bento.tooling_compact' | t }}</span></p></div>
        <figure class="pimm-bento__media"><img src="{{ 'pimm-bento-20260903-r06-30g-tooling.webp' | asset_url }}" alt="{{ 'products.pimm_machine.alt.30g.tooling' | t | escape }}" width="1600" height="2000" loading="lazy" decoding="async"></figure>
      </article>

      <article class="pimm-bento__tile pimm-bento__tile--render pimm-bento__tile--configuration">
        <div class="pimm-bento__copy"><h3>{{ 'products.pimm_machine.purchase.heading' | t }}</h3><p><span class="pimm-bento__text-full">{{ 'products.pimm_machine.purchase.body' | t }}</span><span class="pimm-bento__text-compact">{{ 'pimm_bento.configuration_compact' | t }}</span></p></div>
        <figure class="pimm-bento__media" data-pimm-full-machine data-pimm-physical-ground-contact><img src="{{ 'pimm-bento-20260903-r06-30g-configuration.webp' | asset_url }}" alt="{{ 'products.pimm_machine.alt.30g.hero' | t | escape }}" width="2400" height="1200" loading="lazy" decoding="async"></figure>
      </article>

    </div>
  </section>
{% endif %}
