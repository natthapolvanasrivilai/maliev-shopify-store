{% doc %}
  Renders the shared PIMM decision header and authoritative hero for each model.

  @param {object} product
  @param {object} section
  @param {string} selected_model_code
  @param {object} selected_variant
  @param {object} specifications
  @param {number} full_price_cents
  @param {number} lead_time
  @param {boolean} model_contract_valid
  @param {string} factory_visit_url
{% enddoc %}

<header class="pimm-machine__hero" data-pimm-hero>
  <div class="pimm-machine__decision">
    <p class="pimm-machine__eyebrow">{{ 'products.pimm_machine.hero.evidence_heading' | t }}</p>
    <h1 class="pimm-machine__title">{{ product.title | escape }}</h1>
    <p class="pimm-machine__promise">{{ 'products.pimm_machine.hero.promise' | t }}</p>
    <p class="pimm-machine__fit">{{ 'products.pimm_machine.hero.fit_statement' | t }}</p>

    {% render 'pimm-model-selector', product: product, selected_variant: selected_variant, section: section %}

    <div class="pimm-machine__actions">
      <a class="button button--primary" href="{{ factory_visit_url }}">{{ 'products.pimm_machine.purchase.book_visit' | t }}</a>
      <a class="pimm-machine__text-link" href="#PimmMachineQualification-{{ section.id }}">{{ 'products.pimm_machine.purchase.heading' | t }}</a>
    </div>
  </div>

  <figure class="pimm-machine__hero-stage">
    <div
      class="pimm-machine__hero-media pimm-machine__hero-media--30g"
      data-pimm-media-model="30G"
      data-pimm-media-slot="hero"
      data-pimm-full-machine
      data-pimm-physical-ground-contact
      {% unless selected_model_code == '30G' and model_contract_valid %}hidden inert aria-hidden="true"{% else %}aria-hidden="false"{% endunless %}
    >
        <img
          src="{{ 'pimm-master-20260831-r02-30g-hero.webp' | asset_url }}"
          alt="{{ 'products.pimm_machine.alt.30g.hero' | t | escape }}"
          width="1600"
          height="1920"
          loading="{% if selected_model_code == '30G' %}eager{% else %}lazy{% endif %}"
          decoding="async"
          {% if selected_model_code == '30G' %}fetchpriority="high"{% endif %}
        >
    </div>
    <div
      class="pimm-machine__hero-media pimm-machine__hero-media--50g"
      data-pimm-media-model="50G"
      data-pimm-media-slot="hero"
      data-pimm-full-machine
      data-pimm-physical-ground-contact
      {% unless selected_model_code == '50G' and model_contract_valid %}hidden inert aria-hidden="true"{% else %}aria-hidden="false"{% endunless %}
    >
      <img
        src="{{ 'pimm-master-20260831-r02-50g-hero.webp' | asset_url }}"
        alt="{{ 'products.pimm_machine.alt.50g.hero' | t | escape }}"
        width="1600"
        height="1920"
        loading="{% if selected_model_code == '50G' %}eager{% else %}lazy{% endif %}"
        decoding="async"
        {% if selected_model_code == '50G' %}fetchpriority="high"{% endif %}
      >
    </div>
  </figure>

  <aside class="pimm-machine__specifications" aria-labelledby="PimmMachineEvidence-{{ section.id }}">
    <h2 id="PimmMachineEvidence-{{ section.id }}">{{ 'products.pimm_machine.engineering.heading' | t }}</h2>
    <dl>
      <div><dt>{{ 'products.pimm_machine.specs.capacity.label' | t }}</dt><dd><span data-pimm-spec="shot_capacity_g">{% if model_contract_valid %}{{ specifications.shot_capacity_g }}{% else %}{{ 'products.pimm_machine.status.unavailable' | t }}{% endif %}</span><span data-pimm-spec-unit="shot_capacity_g" aria-hidden="true" {% unless model_contract_valid %}hidden{% endunless %}> {{ 'products.pimm_machine.specs.capacity.unit' | t }}</span></dd></div>
      <div><dt>{{ 'products.pimm_machine.specs.temperature.label' | t }}</dt><dd><span data-pimm-spec="max_melt_temperature_c">{% if model_contract_valid %}{{ specifications.max_melt_temperature_c }}{% else %}{{ 'products.pimm_machine.status.unavailable' | t }}{% endif %}</span><span data-pimm-spec-unit="max_melt_temperature_c" aria-hidden="true" {% unless model_contract_valid %}hidden{% endunless %}> {{ 'products.pimm_machine.specs.temperature.unit' | t }}</span></dd></div>
      <div><dt>{{ 'products.pimm_machine.specs.mold_envelope.label' | t }}</dt><dd><span data-pimm-spec="mold_envelope">{% if model_contract_valid %}{{ specifications.mold_envelope_mm.width }} × {{ specifications.mold_envelope_mm.height }} × {{ specifications.mold_envelope_mm.depth }}{% else %}{{ 'products.pimm_machine.status.unavailable' | t }}{% endif %}</span><span data-pimm-spec-unit="mold_envelope" aria-hidden="true" {% unless model_contract_valid %}hidden{% endunless %}> {{ 'products.pimm_machine.specs.mold_envelope.unit' | t }}</span></dd></div>
      <div><dt>{{ 'products.pimm_machine.specs.pressure.label' | t }}</dt><dd><span data-pimm-spec="max_air_pressure_mpa">{% if model_contract_valid %}{{ specifications.max_air_pressure_mpa }}{% else %}{{ 'products.pimm_machine.status.unavailable' | t }}{% endif %}</span><span data-pimm-spec-unit="max_air_pressure_mpa" aria-hidden="true" {% unless model_contract_valid %}hidden{% endunless %}> {{ 'products.pimm_machine.specs.pressure.unit' | t }}</span></dd></div>
    </dl>
  </aside>
</header>

{% render 'pimm-qualification-strip',
  selected_variant: selected_variant,
  model_contract_valid: model_contract_valid,
  full_price_cents: full_price_cents,
  lead_time: lead_time,
  section: section,
  factory_visit_url: factory_visit_url
%}
