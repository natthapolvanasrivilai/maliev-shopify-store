{% comment %}
  MALIEV collection card.

  Preserves the established card_collection, media_aspect_ratio, columns,
  extend_height, wrapper_class, and placeholder_image parameters.
{% endcomment %}

{%- liquid
  assign ratio = 1
  if card_collection.featured_image and media_aspect_ratio == 'portrait'
    assign ratio = 0.8
  elsif card_collection.featured_image and media_aspect_ratio == 'adapt'
    assign ratio = card_collection.featured_image.aspect_ratio
  endif
  if ratio == 0 or ratio == blank
    assign ratio = 1
  endif

  assign collection_image_loading = 'lazy'
  assign collection_image_sizes = '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 92vw'
  if featured
    assign collection_image_loading = 'eager'
    assign collection_image_sizes = '(min-width: 990px) 50vw, 92vw'
  endif
-%}

<article class="mc-collection-card{% if featured %} mc-collection-card--featured{% endif %}{% if extend_height %} mc-collection-card--stretch{% endif %}{% if wrapper_class and wrapper_class != 'none' %} {{ wrapper_class }}{% endif %}">
  {%- if card_collection != blank -%}
    <a class="mc-collection-card__link" href="{{ card_collection.url }}" aria-label="{{ card_collection.title | escape }}">
      <span class="mc-collection-card__media" style="--mc-collection-ratio: {{ 1 | divided_by: ratio | times: 100 }}%;">
        {%- if card_collection.featured_image -%}
          {{
            card_collection.featured_image
            | image_url: width: 1600
            | image_tag:
              class: 'mc-collection-card__image',
              widths: '320, 480, 640, 800, 1000, 1200, 1600',
              sizes: collection_image_sizes,
              loading: collection_image_loading,
              alt: ''
          }}
        {%- else -%}
          {{ placeholder_image | default: 'collection-1' | placeholder_svg_tag: 'mc-collection-card__placeholder' }}
        {%- endif -%}
      </span>

      <span class="mc-collection-card__body">
        <span class="mc-collection-card__title">{{ card_collection.title | escape }}</span>
        {%- if card_collection.description != blank -%}
          <span class="mc-collection-card__description">{{ card_collection.description | strip_html | truncatewords: 16 }}</span>
        {%- endif -%}
        <span class="mc-collection-card__count">
          {{ 'products.facets.product_count_simple' | t: count: card_collection.all_products_count }}
        </span>
        <span class="mc-collection-card__arrow" aria-hidden="true">→</span>
      </span>
    </a>
  {%- else -%}
    <div class="mc-collection-card__link mc-collection-card__link--placeholder">
      <span class="mc-collection-card__media" style="--mc-collection-ratio: 100%;">
        {{ placeholder_image | default: 'collection-1' | placeholder_svg_tag: 'mc-collection-card__placeholder' }}
      </span>
      <span class="mc-collection-card__body">
        <span class="mc-collection-card__title">{{ 'onboarding.collection_title' | t }}</span>
      </span>
    </div>
  {%- endif -%}
</article>
