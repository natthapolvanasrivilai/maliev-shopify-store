{% comment %}
  MALIEV journal card.

  Preserves the established article-card parameters used by journal and search
  sections while providing one semantic, non-duplicated card structure.
{% endcomment %}

{%- if article and article != empty -%}
  {%- liquid
    assign ratio = 1.5
    if media_aspect_ratio != blank and media_aspect_ratio != 'adapt'
      assign ratio = media_aspect_ratio
    elsif article.image and media_aspect_ratio == 'adapt'
      assign ratio = article.image.aspect_ratio
    endif
    if ratio == 0 or ratio == blank
      assign ratio = 1.5
    endif

    assign image_loading = 'lazy'
    if lazy_load == false
      assign image_loading = 'eager'
    endif
  -%}

  <article class="mc-article-card" aria-labelledby="Article-{{ article.id }}">
    {%- if show_image and article.image -%}
      <a class="mc-article-card__media" href="{{ article.url }}" tabindex="-1" aria-hidden="true" style="--mc-article-ratio: {{ 1 | divided_by: ratio | times: 100 }}%;">
        {{
          article.image
          | image_url: width: 1400
          | image_tag:
            class: 'mc-article-card__image',
            widths: '320, 480, 640, 800, 1000, 1200, 1400',
            sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 92vw',
            loading: image_loading,
            alt: article.image.alt
        }}
      </a>
    {%- endif -%}

    <div class="mc-article-card__body">
      <div class="mc-article-card__meta">
        {%- if show_badge -%}<span>{{ 'blogs.article.blog' | t }}</span>{%- endif -%}
        {%- if show_date -%}<span>{{ article.published_at | time_tag: format: 'date' }}</span>{%- endif -%}
        {%- if show_author -%}<span>{{ article.author | escape }}</span>{%- endif -%}
      </div>

      <h3 class="mc-article-card__title" id="Article-{{ article.id }}">
        <a href="{{ article.url }}">{{ article.title | escape }}</a>
      </h3>

      {%- if show_excerpt and article.excerpt.size > 0 or show_excerpt and article.content.size > 0 -%}
        <p class="mc-article-card__excerpt">
          {%- if article.excerpt.size > 0 -%}
            {{ article.excerpt | strip_html | truncatewords: 28 }}
          {%- else -%}
            {{ article.content | strip_html | truncatewords: 28 }}
          {%- endif -%}
        </p>
      {%- endif -%}

      {%- if show_excerpt and article.comments_count > 0 and blog.comments_enabled? -%}
        <p class="mc-article-card__comments">{{ 'blogs.article.comments' | t: count: article.comments_count }}</p>
      {%- endif -%}
    </div>
  </article>
{%- endif -%}
