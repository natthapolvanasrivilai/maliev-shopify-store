{% comment %}
  MALIEV price presentation.

  Accepts the established product, placeholder, use_variant, show_badges,
  price_class, and show_compare_at_price parameters.
{% endcomment %}

{%- liquid
  if use_variant
    assign target = product.selected_or_first_available_variant
  elsif placeholder
    assign target = null
  else
    assign target = product
  endif

  assign compare_at_price = target.compare_at_price
  assign price = target.price | default: 1999
  assign available = target.available | default: false
  assign has_sale = false
  assign money_price = price | money
  assign money_compare_at = compare_at_price | money
  assign money_price_min = product.price_min | money
  assign money_price_max = product.price_max | money

  if settings.currency_code_enabled
    assign money_price = price | money_with_currency
    assign money_compare_at = compare_at_price | money_with_currency
    assign money_price_min = product.price_min | money_with_currency
    assign money_price_max = product.price_max | money_with_currency
  endif

  if target == product and product.price_varies
    assign money_price = 'products.product.price.from_price_html' | t: price: money_price
  endif

  if compare_at_price > price
    assign has_sale = true
  endif
-%}

{%- unless target == null and placeholder == null -%}
  <div class="mc-price price{% if price_class != blank %} {{ price_class }}{% endif %}{% unless available %} price--sold-out{% endunless %}{% if has_sale %} price--on-sale{% endif %}">
    <div class="mc-price__values price__container">
      {%- if product.quantity_price_breaks_configured? -%}
        {%- if show_compare_at_price and has_sale -%}
          <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
          <s class="mc-price__compare price-item price-item--regular variant-item__old-price">{{ money_compare_at }}</s>
        {%- endif -%}
        <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
        <span class="mc-price__current price-item price-item--regular">
          {{- 'products.product.volume_pricing.price_range' | t: minimum: money_price_min, maximum: money_price_max -}}
        </span>
      {%- elsif has_sale -%}
        <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
        <s class="mc-price__compare price-item price-item--regular">{{ money_compare_at }}</s>
        <span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>
        <span class="mc-price__current mc-price__current--sale price-item price-item--sale price-item--last">{{ money_price }}</span>
      {%- else -%}
        <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
        <span class="mc-price__current price-item price-item--regular">{{ money_price }}</span>
      {%- endif -%}

      {%- if product.selected_or_first_available_variant.unit_price_measurement -%}
        {% render 'unit-price', price: product.selected_or_first_available_variant.unit_price, measurement: product.selected_or_first_available_variant.unit_price_measurement %}
      {%- endif -%}
    </div>

    {%- if show_badges and has_sale -%}
      <span class="mc-price__badge badge price__badge-sale color-{{ settings.sale_badge_color_scheme }}">
        {{- 'products.product.on_sale' | t -}}
      </span>
    {%- elsif show_badges and available == false -%}
      <span class="mc-price__badge badge price__badge-sold-out color-{{ settings.sold_out_badge_color_scheme }}">
        {{- 'products.product.sold_out' | t -}}
      </span>
    {%- endif -%}
  </div>
{%- endunless -%}
